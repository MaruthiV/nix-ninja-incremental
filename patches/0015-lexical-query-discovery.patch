+pub struct Source {
+    pub text: String,
+    pub complete: bool,
+    code: Vec<bool>,
+}
+
+fn identifier(byte: u8) -> bool {
+    byte.is_ascii_alphanumeric() || byte == b'_'
+}
+
+fn splice_end(bytes: &[u8], index: usize) -> Option<usize> {
+    if bytes[index] != b'\\' {
+        return None;
+    }
+    let mut end = index + 1;
+    while bytes
+        .get(end)
+        .is_some_and(|byte| matches!(byte, b' ' | b'\t' | 11 | 12))
+    {
+        end += 1;
+    }
+    match bytes.get(end) {
+        Some(b'\n') => Some(end + 1),
+        Some(b'\r') => Some(end + 1 + usize::from(bytes.get(end + 1) == Some(&b'\n'))),
+        _ => None,
+    }
+}
+
+impl Source {
+    pub fn new(bytes: &[u8]) -> Self {
+        let mut complete = true;
+        let original = match std::str::from_utf8(bytes) {
+            Ok(_) => bytes,
+            Err(error) => {
+                complete = false;
+                let end = bytes[..error.valid_up_to()]
+                    .iter()
+                    .rposition(|byte| *byte == b'\n')
+                    .map_or(0, |index| index + 1);
+                &bytes[..end]
+            }
+        };
+        let mut prepared = Vec::new();
+        let mut origins = Vec::new();
+        let mut index = if original.starts_with(b"\xef\xbb\xbf") {
+            3
+        } else {
+            0
+        };
+        while index < original.len() {
+            if let Some(end) = splice_end(original, index) {
+                index = end;
+                continue;
+            }
+            let byte = original[index];
+            prepared.push(if byte == b'\r' { b'\n' } else { byte });
+            origins.push(index);
+            index += 1;
+            if byte == b'\r' && original.get(index) == Some(&b'\n') {
+                index += 1;
+            }
+        }
+        let mut text = Vec::new();
+        let mut code = Vec::new();
+        let mut index = 0;
+        while index < prepared.len() {
+            let tail = &prepared[index..];
+            if tail.starts_with(b"/*") || tail.starts_with(b"//") {
+                let block = tail[1] == b'*';
+                let end = if block {
+                    match tail[2..].windows(2).position(|part| part == b"*/") {
+                        Some(offset) => index + offset + 4,
+                        None => {
+                            complete = false;
+                            prepared.len()
+                        }
+                    }
+                } else {
+                    index
+                        + tail
+                            .iter()
+                            .position(|byte| *byte == b'\n')
+                            .unwrap_or(tail.len())
+                };
+                text.resize(text.len() + end - index, b' ');
+                code.resize(text.len(), false);
+                index = end;
+                continue;
+            }
+            if let Some(prefix) = [b"u8R\"".as_slice(), b"LR\"", b"uR\"", b"UR\"", b"R\""]
+                .into_iter()
+                .find(|prefix| tail.starts_with(prefix))
+            {
+                let delimiter_start = index + prefix.len();
+                let open = prepared[delimiter_start..]
+                    .iter()
+                    .take(17)
+                    .position(|byte| *byte == b'(')
+                    .map(|offset| delimiter_start + offset);
+                let Some(open) = open.filter(|open| {
+                    prepared[delimiter_start..*open]
+                        .iter()
+                        .all(|byte| byte.is_ascii_graphic() && !matches!(byte, b'(' | b')' | b'\\'))
+                }) else {
+                    complete = false;
+                    break;
+                };
+                let mut ending = vec![b')'];
+                ending.extend_from_slice(&prepared[delimiter_start..open]);
+                ending.push(b'"');
+                let start = origins[index];
+                let raw_open = origins[open];
+                if raw_open - start != open - index {
+                    complete = false;
+                }
+                let end = match original[raw_open + 1..]
+                    .windows(ending.len())
+                    .position(|part| part == ending)
+                {
+                    Some(offset) => raw_open + 1 + offset + ending.len(),
+                    None => {
+                        complete = false;
+                        original.len()
+                    }
+                };
+                text.extend_from_slice(&original[start..end]);
+                code.resize(text.len(), false);
+                index = origins.partition_point(|offset| *offset < end);
+                continue;
+            }
+            let byte = prepared[index];
+            if byte == b'"' || byte == b'\'' {
+                let mut end = index + 1;
+                let mut closed = false;
+                while end < prepared.len() && prepared[end] != b'\n' {
+                    if prepared[end] == byte {
+                        end += 1;
+                        closed = true;
+                        break;
+                    }
+                    end += if prepared[end] == b'\\' && end + 1 < prepared.len() {
+                        2
+                    } else {
+                        1
+                    };
+                }
+                complete &= closed;
+                text.extend_from_slice(&prepared[index..end]);
+                code.resize(text.len(), false);
+                index = end;
+                continue;
+            }
+            let mut end = index + 1;
+            let number = byte.is_ascii_digit()
+                || (byte == b'.' && prepared.get(end).is_some_and(u8::is_ascii_digit));
+            if number {
+                while end < prepared.len()
+                    && (identifier(prepared[end])
+                        || prepared[end] == b'.'
+                        || (prepared[end] == b'\''
+                            && prepared.get(end + 1).is_some_and(|byte| identifier(*byte))))
+                {
+                    end += 1;
+                }
+            } else if identifier(byte) {
+                while end < prepared.len() && identifier(prepared[end]) {
+                    end += 1;
+                }
+            }
+            text.extend_from_slice(&prepared[index..end]);
+            code.resize(text.len(), !number);
+            index = end;
+        }
+        Self {
+            text: String::from_utf8(text).unwrap(),
+            complete,
+            code,
+        }
+    }
+
+    pub fn is_code(&self, index: usize) -> bool {
+        self.code.get(index).copied().unwrap_or(false)
+    }
+
+    pub fn lines(&self) -> impl Iterator<Item = (usize, &str)> {
+        self.text.split_inclusive('\n').scan(0, |offset, line| {
+            let start = *offset;
+            *offset += line.len();
+            Some((start, line.strip_suffix('\n').unwrap_or(line)))
+        })
+    }
+
+    pub fn estimated_bytes(&self) -> usize {
+        self.text
+            .len()
+            .saturating_add(self.code.len())
+            .saturating_add(64)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn hashes(source: &Source) -> Vec<bool> {
+        source
+            .text
+            .match_indices('#')
+            .map(|(index, _)| source.is_code(index))
+            .collect()
+    }
+
+    #[test]
+    fn trailing_comments_and_comment_closures_keep_only_real_hashes() {
+        let source = Source::new(b"# ifndef assert /* prior #include <assert.h> */\n/*\n# example */ #include \"value.h\"\n");
+        assert!(source.complete);
+        assert_eq!(hashes(&source), vec![true, true]);
+        assert!(source
+            .text
+            .lines()
+            .last()
+            .unwrap()
+            .trim_start()
+            .starts_with("#include"));
+    }
+
+    #[test]
+    fn splices_are_joined_before_comments_are_recognized() {
+        let source = Source::new(b"#i\\\nnclude \"value.h\"\n/\\\n* #include \"fake.h\" */\n// # fake \\\n#include \"hidden.h\"\n");
+        assert!(source.complete);
+        assert_eq!(hashes(&source), vec![true]);
+        assert!(source.text.starts_with("#include \"value.h\""));
+    }
+
+    #[test]
+    fn quoted_and_raw_strings_do_not_expose_directives() {
+        let source = Source::new(
+            br##"const char *s = "/* #include fake */";
+auto r = u8R"tag(
+#include "fake.h"
+)tag";
+#include "real.h"
+"##,
+        );
+        assert!(source.complete);
+        assert_eq!(hashes(&source), vec![false, false, true]);
+    }
+
+    #[test]
+    fn raw_string_splices_cannot_create_a_terminator() {
+        let source = Source::new(b"auto s = R\"tag(before)ta\\\ng\"\n#include \"fake.h\"\n)tag\";\n#include \"real.h\"\n");
+        assert!(source.complete);
+        assert_eq!(hashes(&source), vec![false, true]);
+    }
+
+    #[test]
+    fn digit_separators_and_prefixed_characters_keep_following_code() {
+        let source = Source::new(b"auto n = 0xA'B + 1'000; auto c = u8'x';\n#include \"real.h\"\n");
+        assert!(source.complete);
+        assert_eq!(hashes(&source), vec![true]);
+        let number = Source::new(b"auto n = 10QUERY;\n");
+        assert!(!number.is_code(number.text.find("QUERY").unwrap()));
+    }
+
+    #[test]
+    fn invalid_utf8_keeps_only_complete_prior_lines() {
+        let source = Source::new(b"#include \"first.h\"\n#include \"second.h\"\xff\n");
+        assert!(!source.complete);
+        assert_eq!(source.text, "#include \"first.h\"\n");
+    }
+
+    #[test]
+    fn newlines_inside_comments_do_not_end_a_directive() {
+        let source = Source::new(b"#/* comment\n*/include \"value.h\"\n");
+        assert!(source.complete);
+        assert_eq!(source.lines().count(), 1);
+        assert!(crate::c_queries::LITERAL.is_match(&source.text));
+    }
+}
