+fn resolve_header(
+    caller: &Path,
+    header: &str,
+    directories: &[PathBuf],
+    virtual_paths: Option<&HashMap<PathBuf, PathBuf>>,
+    path_cache: &PathCache,
+    observer: Option<&Arc<Recorder>>,
+    regular: bool,
+) -> Result<Option<PathBuf>> {
+    let file = Path::new(&header[1..header.len() - 1]);
+    let parent = caller.parent().unwrap();
+    let quoted = header.starts_with('"');
+    for directory in quoted
+        .then_some(parent)
+        .into_iter()
+        .chain(directories.iter().map(PathBuf::as_path))
+    {
+        let Some(candidate) = try_resolve(directory, file, virtual_paths, path_cache, observer)?
+        else {
+            continue;
+        };
+        if regular {
+            let is_file = if let Some(observer) = observer {
+                observer.is_file(&candidate)?
+            } else {
+                canonicalize_with_cache(candidate.clone(), virtual_paths, path_cache, None)?
+                    .is_some_and(|target| target.is_file())
+            };
+            if !is_file {
+                continue;
+            }
+        }
+        return Ok(Some(candidate));
+    }
+    Ok(None)
+}
