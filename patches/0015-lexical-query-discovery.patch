+use crate::c_source::Source;
+use regex::Regex;
+use std::collections::{BTreeSet, HashMap, VecDeque};
+use std::ops::Range;
+use std::sync::LazyLock;
+
+pub static DIRECTIVE: LazyLock<Regex> =
+    LazyLock::new(|| Regex::new(r"^\s*#\s*([A-Za-z_][A-Za-z_0-9]*)").unwrap());
+pub static LITERAL: LazyLock<Regex> =
+    LazyLock::new(|| Regex::new(r##"^\s*#\s*(include|embed)\s*("[^"\n]+"|<[^>\n]+>)"##).unwrap());
+static DEFINITION: LazyLock<Regex> =
+    LazyLock::new(|| Regex::new(r"^\s*#\s*define\s+([A-Za-z_][A-Za-z_0-9]*)(.*)$").unwrap());
+static IDENTIFIER: LazyLock<Regex> =
+    LazyLock::new(|| Regex::new(r"[A-Za-z_][A-Za-z_0-9]*").unwrap());
+static CALL: LazyLock<Regex> = LazyLock::new(|| {
+    Regex::new(r##"\b([A-Za-z_][A-Za-z_0-9]*)\s*\(\s*("[^"\n]+"|<[^>\n]+>)\s*\)"##).unwrap()
+});
+static FEATURE: LazyLock<Regex> = LazyLock::new(|| {
+    Regex::new(r"\bdefined\s*(?:\(\s*[A-Za-z_][A-Za-z_0-9]*\s*\)|[A-Za-z_][A-Za-z_0-9]*)").unwrap()
+});
+static FEATURE_DIRECTIVE: LazyLock<Regex> =
+    LazyLock::new(|| Regex::new(r"^\s*#\s*ifn?def\s+[A-Za-z_][A-Za-z_0-9]*\b").unwrap());
+
+#[derive(Clone)]
+pub enum Replacement {
+    Alias(String),
+    Constant,
+    Other,
+}
+
+#[derive(Clone)]
+pub struct Definition {
+    pub name: String,
+    pub replacement: Replacement,
+    pub references: Vec<String>,
+    pub range: Range<usize>,
+}
+
+#[derive(Clone)]
+pub struct Call {
+    pub name: String,
+    pub header: String,
+    pub range: Range<usize>,
+}
+
+#[derive(Default)]
+pub struct Facts {
+    pub definitions: Vec<Definition>,
+    pub calls: Vec<Call>,
+}
+
+impl Facts {
+    pub fn new(source: &Source) -> Self {
+        let mut facts = Self::default();
+        for (offset, line) in source.lines() {
+            let Some(hash) = line
+                .find('#')
+                .filter(|index| source.is_code(offset + index))
+            else {
+                continue;
+            };
+            if !line[..hash].trim().is_empty() {
+                continue;
+            }
+            if let Some(definition) = DEFINITION.captures(line) {
+                let tail = definition.get(2).unwrap();
+                let function = tail.as_str().starts_with('(');
+                let body = if function {
+                    tail.as_str()
+                        .split_once(')')
+                        .map_or("", |(_, body)| body)
+                        .trim()
+                } else {
+                    tail.as_str().trim()
+                };
+                let replacement = if matches!(body, "0" | "1") {
+                    Replacement::Constant
+                } else if !function
+                    && IDENTIFIER
+                        .find(body)
+                        .is_some_and(|value| value.as_str() == body)
+                {
+                    Replacement::Alias(body.to_owned())
+                } else {
+                    Replacement::Other
+                };
+                let references = IDENTIFIER
+                    .find_iter(tail.as_str())
+                    .filter(|value| source.is_code(offset + tail.start() + value.start()))
+                    .map(|value| value.as_str().to_owned())
+                    .collect();
+                facts.definitions.push(Definition {
+                    name: definition[1].to_owned(),
+                    replacement,
+                    references,
+                    range: offset..offset + line.len(),
+                });
+                if facts.definitions.len() > 100_000 {
+                    break;
+                }
+            }
+        }
+        for call in CALL.captures_iter(&source.text) {
+            let span = call.get(0).unwrap();
+            if source.is_code(span.start()) {
+                facts.calls.push(Call {
+                    name: call[1].to_owned(),
+                    header: call[2].to_owned(),
+                    range: span.range(),
+                });
+                if facts.calls.len() > 100_000 {
+                    break;
+                }
+            }
+        }
+        facts
+    }
+
+    pub fn estimated_bytes(&self) -> usize {
+        let definitions = self.definitions.iter().map(|definition| {
+            let target = match &definition.replacement {
+                Replacement::Alias(value) => value.len(),
+                _ => 0,
+            };
+            definition.references.iter().fold(
+                128usize
+                    .saturating_add(definition.name.len())
+                    .saturating_add(target),
+                |size, value| size.saturating_add(value.len()).saturating_add(32),
+            )
+        });
+        let calls = self.calls.iter().map(|call| {
+            96usize
+                .saturating_add(call.name.len())
+                .saturating_add(call.header.len())
+        });
+        definitions.chain(calls).fold(0, usize::saturating_add)
+    }
+}
+
+pub fn command_definitions(command: &str) -> Result<Vec<Definition>, &'static str> {
+    let args = shell_words::split(command).map_err(|_| "command-syntax")?;
+    let mut definitions = Vec::new();
+    let mut index = 0;
+    while index < args.len() {
+        let value = if args[index] == "-D" {
+            index += 1;
+            Some(args.get(index).ok_or("missing-macro-definition")?.as_str())
+        } else {
+            args[index].strip_prefix("-D")
+        };
+        if let Some(value) = value {
+            if value.contains(['\n', '\r']) {
+                return Err("unsupported-command-macro");
+            }
+            let (name, replacement) = value.split_once('=').unwrap_or((value, "1"));
+            let source = Source::new(format!("#define {name} {replacement}\n").as_bytes());
+            let facts = Facts::new(&source);
+            if !source.complete || facts.definitions.len() != 1 {
+                return Err("unsupported-command-macro");
+            }
+            definitions.extend(facts.definitions);
+        }
+        index += 1;
+    }
+    Ok(definitions)
+}
+
+pub struct Aliases {
+    names: BTreeSet<String>,
+}
+
+impl Aliases {
+    pub fn new(definitions: &[Definition]) -> Result<Self, &'static str> {
+        if definitions.len() > 100_000 {
+            return Err("query-definition-budget");
+        }
+        let mut reverse = HashMap::<&str, Vec<&str>>::new();
+        for definition in definitions {
+            if let Replacement::Alias(target) = &definition.replacement {
+                reverse.entry(target).or_default().push(&definition.name);
+            }
+        }
+        let mut names = BTreeSet::from(["__has_include".to_owned()]);
+        let mut queue = VecDeque::from(["__has_include"]);
+        while let Some(target) = queue.pop_front() {
+            for name in reverse.get(target).into_iter().flatten() {
+                if names.insert((*name).to_owned()) {
+                    if names.len() > 4096 {
+                        return Err("query-alias-budget");
+                    }
+                    queue.push_back(name);
+                }
+            }
+        }
+        Ok(Self { names })
+    }
+
+    pub fn contains(&self, name: &str) -> bool {
+        self.names.contains(name)
+    }
+
+    pub fn check_definitions(&self, definitions: &[Definition]) -> Result<(), &'static str> {
+        for definition in definitions {
+            match &definition.replacement {
+                Replacement::Alias(target) if target == "__has_embed" => {
+                    return Err("unsupported-query-alias")
+                }
+                Replacement::Other
+                    if self.contains(&definition.name)
+                        || definition.name == "__has_embed"
+                        || definition
+                            .references
+                            .iter()
+                            .any(|name| self.contains(name) || name == "__has_embed") =>
+                {
+                    return Err("computed-query-alias")
+                }
+                _ => {}
+            }
+        }
+        Ok(())
+    }
+
+    pub fn check_source(&self, source: &Source, facts: &Facts) -> Result<(), &'static str> {
+        self.check_definitions(&facts.definitions)?;
+        let mut allowed: Vec<_> = facts
+            .definitions
+            .iter()
+            .map(|definition| definition.range.clone())
+            .collect();
+        for value in FEATURE
+            .find_iter(&source.text)
+            .filter(|value| source.is_code(value.start()))
+        {
+            allowed.push(value.range());
+        }
+        let mut embeds = BTreeSet::new();
+        for (offset, line) in source.lines() {
+            if let Some(value) = FEATURE_DIRECTIVE
+                .find(line)
+                .filter(|value| source.is_code(offset + value.as_str().find('#').unwrap()))
+            {
+                allowed.push(offset..offset + value.end());
+            }
+            if let Some(value) = LITERAL.captures(line).filter(|_| {
+                line.find('#')
+                    .is_some_and(|index| source.is_code(offset + index))
+            }) {
+                if &value[1] == "embed" {
+                    embeds.insert(value[2].to_owned());
+                }
+            }
+        }
+        for call in &facts.calls {
+            if self.contains(&call.name) || call.name == "__has_embed" {
+                if call.header[1..call.header.len() - 1].contains(['"', '>', '\\']) {
+                    return Err("unmodeled-header-name");
+                }
+                if call.name == "__has_embed" && !embeds.contains(&call.header) {
+                    return Err("unobserved-existence-query");
+                }
+                allowed.push(call.range.clone());
+            }
+        }
+        for value in IDENTIFIER
+            .find_iter(&source.text)
+            .filter(|value| source.is_code(value.start()))
+        {
+            if value.as_str() == "__has_include_next" {
+                return Err("include-next");
+            }
+            if (self.contains(value.as_str()) || value.as_str() == "__has_embed")
