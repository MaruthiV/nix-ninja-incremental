+        fs::create_dir_all(fixture.path("early/marker.h")).unwrap();
+        let marker = fixture.write("late/marker.h", "not c");
+        let command = shell_words::join([
+            "cc".to_owned(),
+            format!("-I{}", fixture.path("early").display()),
+            format!("-I{}", fixture.path("late").display()),
+        ]);
+        assert_eq!(
+            scan(&command, &source),
+            HashSet::from([source.clone(), marker])
+        );
+        fs::remove_dir(fixture.path("early/marker.h")).unwrap();
+        let (_, trace) = retrieve_c_dependency_paths_observed(
+            &command,
+            vec![source.clone()],
+            Arc::new(ReadView::new(&fixture.0, &fixture.0).unwrap()),
+        )
+        .unwrap();
+        assert_eq!(
+            trace.resolutions.get(&fixture.path("early/marker.h")),
+            Some(&None)
+        );
+        let early = fixture.write("early/marker.h", "earlier");
+        assert!(!ReadView::new(&fixture.0, &fixture.0)
+            .unwrap()
+            .validate(&trace)
+            .unwrap());
+        assert_eq!(scan(&command, &source), HashSet::from([source, early]));
+    }
