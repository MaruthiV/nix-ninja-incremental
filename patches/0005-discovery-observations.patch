+
+    #[cfg(unix)]
+    #[test]
+    fn owned_links_cannot_hide_an_external_alias_in_the_chain() {
+        let fixture = Fixture::new();
+        let external = Fixture::new();
+        let header = fixture.write("value.h", "#define VALUE 1\n");
+        let bridge = external.0.join("bridge.h");
