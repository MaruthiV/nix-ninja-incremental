+use anyhow::{bail, ensure, Result};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::collections::{BTreeMap, HashMap};
+use std::fs;
+use std::io::ErrorKind;
+use std::path::{Component, Path, PathBuf};
+use std::sync::{Arc, Mutex};
+
+const MAX_FILE_BYTES: u64 = 64 * 1024 * 1024;
+const MAX_RETAINED_BYTES: usize = 128 * 1024 * 1024;
+
+#[derive(Clone, Debug, Default, Deserialize, Serialize)]
+pub struct DiscoveryTrace {
+    pub resolutions: BTreeMap<PathBuf, Option<PathBuf>>,
+    pub files: BTreeMap<PathBuf, String>,
+}
+
+#[derive(Clone)]
+struct Content {
+    digest: String,
+    bytes: Option<Arc<Vec<u8>>>,
+}
+
+#[derive(Default)]
+struct FileMemo {
+    contents: HashMap<PathBuf, Content>,
+    retained_bytes: usize,
+    hashed_bytes: usize,
+}
+
+#[derive(Serialize)]
+pub struct ReadStats {
+    pub files_hashed: usize,
+    pub bytes_hashed: usize,
+    pub resolutions: usize,
+    pub retained_bytes: usize,
+}
+
+#[derive(Clone)]
+struct Resolution {
+    path: Option<PathBuf>,
+    directory: bool,
+}
+
+impl Resolution {
+    fn absent() -> Self {
+        Self {
+            path: None,
+            directory: false,
+        }
+    }
+}
+
+pub struct ReadView {
+    root: PathBuf,
+    cwd: PathBuf,
+    resolutions: Mutex<HashMap<PathBuf, Resolution>>,
+    files: Mutex<FileMemo>,
+}
+
+impl ReadView {
+    pub fn new(root: &Path, cwd: &Path) -> Result<Self> {
+        let root = root.canonicalize()?;
+        let cwd = cwd.canonicalize()?;
+        ensure!(
+            root.is_dir() && cwd.is_dir(),
+            "input roots must be directories"
+        );
+        ensure!(
+            cwd.starts_with(&root),
+            "working directory escapes input view"
+        );
+        Ok(Self {
+            root,
+            cwd,
+            resolutions: Mutex::default(),
+            files: Mutex::default(),
+        })
+    }
+
+    fn stable(&self, path: &Path) -> bool {
+        if path.starts_with(&self.root) {
+            return true;
+        }
+        let Ok(relative) = path.strip_prefix("/nix/store") else {
+            return false;
+        };
+        relative
+            .components()
+            .next()
+            .is_some_and(|name| Path::new("/nix/store").join(name).exists())
+    }
+
+    pub fn resolve(&self, path: &Path) -> Result<Option<PathBuf>> {
+        let absolute = self.cwd.join(path);
+        let mut memo = self.resolutions.lock().unwrap();
+        Ok(self.resolve_path(&absolute, &mut memo, 0)?.path)
+    }
+
+    fn resolve_path(
+        &self,
+        path: &Path,
+        memo: &mut HashMap<PathBuf, Resolution>,
+        depth: usize,
+    ) -> Result<Resolution> {
+        ensure!(depth <= 40, "symlink chain exceeds observation limit");
+        if let Some(result) = memo.get(path) {
+            return Ok(result.clone());
+        }
+        let anchor = if path.starts_with(&self.root) {
+            self.root.clone()
+        } else if let Ok(relative) = path.strip_prefix("/nix/store") {
+            let package = relative
+                .components()
+                .next()
+                .ok_or_else(|| anyhow::anyhow!("store pool is not a stable root"))?;
+            ensure!(
+                Path::new("/nix/store").join(package).exists(),
+                "store package is absent"
+            );
+            PathBuf::from("/nix/store")
+        } else {
+            bail!("lookup escapes stable roots: {}", path.display());
+        };
+        let mut current = Resolution {
+            path: Some(anchor.clone()),
+            directory: true,
+        };
+        for component in path.strip_prefix(&anchor)?.components() {
+            if !current.directory {
+                current = Resolution::absent();
+                break;
+            }
+            let parent = current.path.as_ref().unwrap();
+            let next = match component {
+                Component::CurDir => continue,
+                Component::ParentDir => {
+                    let next = parent
+                        .parent()
+                        .ok_or_else(|| anyhow::anyhow!("lookup escapes filesystem root"))?
+                        .to_owned();
+                    ensure!(self.stable(&next), "parent lookup escapes stable roots");
+                    current = Resolution {
+                        path: Some(next),
+                        directory: true,
+                    };
+                    continue;
+                }
+                Component::Normal(name) => parent.join(name),
+                _ => bail!("unexpected absolute path component"),
+            };
+            current = if let Some(result) = memo.get(&next) {
+                result.clone()
+            } else {
+                let result = match fs::symlink_metadata(&next) {
+                    Ok(metadata) if metadata.is_symlink() => {
+                        let target = parent.join(fs::read_link(&next)?);
+                        self.resolve_path(&target, memo, depth + 1)?
+                    }
+                    Ok(metadata) => {
+                        ensure!(
+                            metadata.is_dir() || metadata.is_file(),
+                            "unsupported lookup file type"
+                        );
+                        ensure!(self.stable(&next), "lookup escapes stable roots");
+                        Resolution {
+                            path: Some(next.clone()),
+                            directory: metadata.is_dir(),
+                        }
+                    }
+                    Err(error)
+                        if matches!(
+                            error.kind(),
+                            ErrorKind::NotFound | ErrorKind::NotADirectory
+                        ) =>
+                    {
+                        ensure!(self.stable(parent), "absence has no stable parent");
+                        Resolution::absent()
+                    }
+                    Err(error) => return Err(error.into()),
+                };
+                memo.insert(next, result.clone());
+                result
+            };
+            if current.path.is_none() {
+                break;
+            }
+        }
+        memo.insert(path.to_owned(), current.clone());
+        Ok(current)
+    }
+
+    fn content(&self, path: &Path, retain: bool) -> Result<Content> {
+        ensure!(
+            self.stable(path),
+            "file escapes stable roots: {}",
+            path.display()
+        );
+        let mut memo = self.files.lock().unwrap();
+        if let Some(content) = memo.contents.get(path) {
+            if !retain || content.bytes.is_some() {
+                return Ok(content.clone());
+            }
+        }
+        let metadata = fs::metadata(path)?;
+        ensure!(metadata.is_file(), "observation requires a regular file");
+        ensure!(
+            metadata.len() <= MAX_FILE_BYTES,
+            "file exceeds observation limit"
+        );
+        if retain {
+            ensure!(
+                memo.retained_bytes + metadata.len() as usize <= MAX_RETAINED_BYTES,
+                "input view exceeds retained-byte limit"
+            );
+        }
+        let bytes = fs::read(path)?;
+        ensure!(
+            bytes.len() as u64 <= MAX_FILE_BYTES,
+            "file exceeds observation limit"
+        );
+        let size = bytes.len();
+        let digest = format!("{:x}", Sha256::digest(&bytes));
+        let content = Content {
+            digest,
+            bytes: retain.then(|| Arc::new(bytes)),
+        };
+        memo.hashed_bytes += size;
+        if retain {
+            memo.retained_bytes += size;
+        }
+        memo.contents.insert(path.to_owned(), content.clone());
+        Ok(content)
+    }
+
+    pub fn validate(&self, trace: &DiscoveryTrace) -> Result<bool> {
+        for (path, expected) in &trace.resolutions {
+            if &self.resolve(path)? != expected {
+                return Ok(false);
+            }
+        }
+        for (path, expected) in &trace.files {
+            if &self.content(path, false)?.digest != expected {
+                return Ok(false);
+            }
+        }
+        Ok(true)
+    }
+
+    pub fn fingerprint(&self, path: &Path) -> Result<String> {
+        Ok(self.content(path, false)?.digest)
+    }
+
+    pub fn stats(&self) -> ReadStats {
+        let files = self.files.lock().unwrap();
+        ReadStats {
+            files_hashed: files.contents.len(),
+            bytes_hashed: files.hashed_bytes,
+            resolutions: self.resolutions.lock().unwrap().len(),
+            retained_bytes: files.retained_bytes,
+        }
+    }
+}
+
+pub(crate) struct Recorder {
+    view: Arc<ReadView>,
+    trace: Mutex<DiscoveryTrace>,
+}
+
+impl Recorder {
+    pub fn new(view: Arc<ReadView>) -> Self {
+        Self {
+            view,
+            trace: Mutex::default(),
+        }
+    }
+
+    pub fn resolve(&self, path: &Path) -> Result<Option<PathBuf>> {
+        let result = self.view.resolve(path)?;
+        self.trace
+            .lock()
+            .unwrap()
+            .resolutions
+            .insert(self.view.cwd.join(path), result.clone());
+        Ok(result)
+    }
+
+    pub fn read(&self, path: &Path) -> Result<Arc<Vec<u8>>> {
+        let content = self.view.content(path, true)?;
+        self.trace
+            .lock()
+            .unwrap()
+            .files
+            .insert(path.to_owned(), content.digest);
+        Ok(content.bytes.unwrap())
+    }
+
+    pub fn trace(&self) -> DiscoveryTrace {
+        self.trace.lock().unwrap().clone()
+    }
+}
