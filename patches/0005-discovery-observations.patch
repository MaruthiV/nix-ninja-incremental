+
+    #[test]
+    fn missing_or_regular_file_parents_do_not_collapse_lexically() {
+        let fixture = Fixture::new();
+        fixture.write("value.h", "#define VALUE 1\n");
+        fixture.write("regular", "not a directory\n");
+        for parent in ["missing", "regular"] {
+            let query = fixture.0.join(parent).join("../value.h");
+            assert_eq!(
+                crate::c_include_parser::canonicalize_cached(query.clone(), None).unwrap(),
+                None
+            );
+            assert_eq!(fixture.view().resolve(&query).unwrap(), None);
+        }
+    }
