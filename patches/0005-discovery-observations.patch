+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::c_include_parser::{retrieve_c_includes, retrieve_c_includes_observed};
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    static NEXT_ID: AtomicU64 = AtomicU64::new(0);
+
+    struct Fixture(PathBuf);
+
+    impl Fixture {
+        fn new() -> Self {
+            let id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+            let path =
+                std::env::temp_dir().join(format!("nni-observations-{}-{id}", std::process::id()));
+            fs::create_dir(&path).unwrap();
+            Self(path.canonicalize().unwrap())
+        }
+
+        fn write(&self, name: &str, bytes: impl AsRef<[u8]>) -> PathBuf {
+            let path = self.0.join(name);
+            fs::create_dir_all(path.parent().unwrap()).unwrap();
+            fs::write(&path, bytes).unwrap();
+            path
+        }
+
+        fn view(&self) -> Arc<ReadView> {
+            Arc::new(ReadView::new(&self.0, &self.0).unwrap())
+        }
+
+        fn trace(&self, command: &str, source: &Path) -> DiscoveryTrace {
+            let seeds = vec![source.to_owned()];
+            let (observed, trace) =
+                retrieve_c_includes_observed(command, seeds.clone(), self.view()).unwrap();
+            assert_eq!(observed, retrieve_c_includes(command, seeds, None).unwrap());
+            trace
+        }
+    }
+
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.0);
+        }
+    }
+
+    #[test]
+    fn newly_shadowing_header_invalidates_negative_observation() {
+        let fixture = Fixture::new();
+        let source = fixture.write("main.c", "#include <value.h>\n");
+        fs::create_dir(fixture.0.join("early")).unwrap();
+        fixture.write("late/value.h", "#define VALUE 1\n");
+        let command = shell_words::join([
+            "cc".to_owned(),
+            format!("-I{}", fixture.0.join("early").display()),
+            format!("-I{}", fixture.0.join("late").display()),
+        ]);
+        let trace = fixture.trace(&command, &source);
+        assert!(fixture.view().validate(&trace).unwrap());
+        fixture.write("early/value.h", "#define VALUE 2\n");
+        assert!(!fixture.view().validate(&trace).unwrap());
+    }
+
+    #[test]
+    fn content_change_with_preserved_mtime_invalidates() {
+        let fixture = Fixture::new();
+        let source = fixture.write("main.c", "#include \"value.h\"\n");
+        let header = fixture.write("value.h", "#define VALUE 1\n");
+        let trace = fixture.trace("cc -c main.c", &source);
+        let modified = fs::metadata(&header).unwrap().modified().unwrap();
+        fixture.write("value.h", "#define VALUE 2\n");
+        fs::File::open(&header)
+            .unwrap()
+            .set_times(fs::FileTimes::new().set_modified(modified))
+            .unwrap();
+        assert_eq!(fs::metadata(header).unwrap().modified().unwrap(), modified);
+        assert!(!fixture.view().validate(&trace).unwrap());
+    }
+
+    #[test]
+    fn irrelevant_changes_preserve_the_trace() {
+        let fixture = Fixture::new();
+        let source = fixture.write("main.c", "int main(void) { return 0; }\n");
+        let trace = fixture.trace("cc -c main.c", &source);
+        fixture.write("unrelated/other.h", "#define OTHER 9\n");
+        assert!(fixture.view().validate(&trace).unwrap());
+    }
+
+    #[test]
+    fn absent_parent_appearance_invalidates() {
+        let fixture = Fixture::new();
+        let source = fixture.write("main.c", "#include \"optional/value.h\"\n");
+        let trace = fixture.trace("cc -c main.c", &source);
+        fixture.write("optional/value.h", "#define VALUE 1\n");
+        assert!(!fixture.view().validate(&trace).unwrap());
+    }
+
+    #[test]
+    fn raw_fingerprints_preserve_invalid_utf8_parser_behavior() {
+        let fixture = Fixture::new();
+        let source = fixture.write(
+            "main.c",
+            b"#include \"first.h\"\n\xff\n#include \"second.h\"\n",
+        );
+        let first = fixture.write("first.h", "#define FIRST 1\n");
+        let second = fixture.write("second.h", "#define SECOND 2\n");
+        let trace = fixture.trace("cc -c main.c", &source);
+        assert!(trace.files.contains_key(&first));
+        assert!(!trace.files.contains_key(&second));
+        fixture.write(
+            "main.c",
+            b"#include \"first.h\"\n\xfe\n#include \"second.h\"\n",
+        );
+        assert!(!fixture.view().validate(&trace).unwrap());
+    }
+
+    #[test]
+    fn shared_memo_keeps_complete_per_action_traces() {
+        let fixture = Fixture::new();
+        let first = fixture.write("first.c", "#include \"shared.h\"\n");
+        let second = fixture.write("second.c", "#include \"shared.h\"\n");
+        let header = fixture.write("shared.h", "#define VALUE 1\n");
+        let view = fixture.view();
+        let (_, a) = retrieve_c_includes_observed("cc", vec![first], view.clone()).unwrap();
+        let (_, b) = retrieve_c_includes_observed("cc", vec![second], view.clone()).unwrap();
+        assert!(a.files.contains_key(&header));
+        assert!(b.files.contains_key(&header));
+        assert_eq!(view.stats().files_hashed, 3);
+        assert_eq!(a.files[&header], b.files[&header]);
+        let validation = fixture.view();
+        assert!(validation.validate(&a).unwrap());
+        assert!(validation.validate(&b).unwrap());
+        assert_eq!(validation.stats().files_hashed, 3);
+        assert_eq!(validation.stats().retained_bytes, 0);
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn symlink_retarget_invalidates_even_with_equal_file_bytes() {
+        let fixture = Fixture::new();
+        let source = fixture.write("main.c", "#include \"alias.h\"\n");
+        let first = fixture.write("first.h", "#define VALUE 1\n");
+        let second = fixture.write("second.h", "#define VALUE 1\n");
+        let alias = fixture.0.join("alias.h");
+        std::os::unix::fs::symlink(first, &alias).unwrap();
+        let trace = fixture.trace("cc", &source);
+        fs::remove_file(&alias).unwrap();
+        std::os::unix::fs::symlink(second, alias).unwrap();
+        assert!(!fixture.view().validate(&trace).unwrap());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn dangling_external_symlinks_cannot_certify_absence() {
+        let fixture = Fixture::new();
+        let external = Fixture::new();
+        let alias = fixture.0.join("alias");
+        std::os::unix::fs::symlink(external.0.join("missing"), &alias).unwrap();
+        assert!(fixture.view().resolve(&alias.join("header.h")).is_err());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn external_aliases_are_rejected_even_when_the_target_is_owned() {
+        let fixture = Fixture::new();
+        let external = Fixture::new();
+        let header = fixture.write("value.h", "#define VALUE 1\n");
+        let alias = external.0.join("alias.h");
+        std::os::unix::fs::symlink(header, &alias).unwrap();
