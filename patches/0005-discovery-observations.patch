+
+    #[cfg(unix)]
+    #[test]
+    fn parent_components_follow_the_physical_symlink_target() {
+        let fixture = Fixture::new();
+        fs::create_dir_all(fixture.0.join("actual/child")).unwrap();
+        let header = fixture.write("actual/value.h", "#define VALUE 1\n");
+        std::os::unix::fs::symlink("actual/child", fixture.0.join("alias")).unwrap();
+        let query = fixture.0.join("alias/../value.h");
+        assert_eq!(query.canonicalize().unwrap(), header);
+        assert_eq!(fixture.view().resolve(&query).unwrap(), Some(header));
