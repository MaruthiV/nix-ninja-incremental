@@ -0,0 +1,472 @@
+use anyhow::{bail, ensure, Result};
+use deps_infer::c_include_parser::{retrieve_c_includes, retrieve_c_includes_observed};
+use deps_infer::observations::{DiscoveryTrace, ReadView};
+use serde::{Deserialize, Serialize};
+use serde_json::json;
+use sha2::{Digest, Sha256};
+use std::collections::{BTreeMap, HashMap};
+use std::fs;
+use std::io::Read;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::time::Instant;
+
+#[derive(Deserialize)]
+struct Descriptor {
+    schema_version: u32,
+    root: PathBuf,
+}
+
+#[derive(Deserialize)]
+struct CompileCommand {
+    directory: PathBuf,
+    file: PathBuf,
+    command: Option<String>,
+    arguments: Option<Vec<String>>,
+}
+
+#[derive(Deserialize, Serialize)]
+struct Action {
+    file: PathBuf,
+    command: String,
+    seeds: Vec<PathBuf>,
+    expected: Option<Vec<PathBuf>>,
+    trace: Option<DiscoveryTrace>,
+    error: Option<String>,
+}
+
+#[derive(Deserialize, Serialize)]
+struct SharedRecord {
+    dependencies: Vec<usize>,
+    resolutions: Vec<usize>,
+    files: Vec<usize>,
+}
+
+#[derive(Default, Deserialize, Serialize)]
+struct SharedBundle {
+    paths: Vec<PathBuf>,
+    resolutions: Vec<(usize, Option<usize>)>,
+    files: Vec<(usize, String)>,
+    records: BTreeMap<String, SharedRecord>,
+}
+
+fn key(action: &Action) -> Result<String> {
+    Ok(format!(
+        "{:x}",
+        Sha256::digest(serde_json::to_vec(&(&action.command, &action.seeds))?)
+    ))
+}
+
+fn intern(path: &Path, paths: &mut Vec<PathBuf>, ids: &mut HashMap<PathBuf, usize>) -> usize {
+    *ids.entry(path.to_owned()).or_insert_with(|| {
+        paths.push(path.to_owned());
+        paths.len() - 1
+    })
+}
+
+impl SharedBundle {
+    fn pack(actions: &[Action]) -> Result<Self> {
+        let mut bundle = Self::default();
+        let mut paths = HashMap::new();
+        let mut resolutions = HashMap::new();
+        let mut files = HashMap::new();
+        for action in actions {
+            let Some(trace) = &action.trace else {
+                continue;
+            };
+            let mut record = SharedRecord {
+                dependencies: Vec::new(),
+                resolutions: Vec::new(),
+                files: Vec::new(),
+            };
+            for path in action.expected.as_ref().unwrap() {
+                record
+                    .dependencies
+                    .push(intern(path, &mut bundle.paths, &mut paths));
+            }
+            for (path, target) in &trace.resolutions {
+                let path_id = intern(path, &mut bundle.paths, &mut paths);
+                let target_id = target
+                    .as_ref()
+                    .map(|target| intern(target, &mut bundle.paths, &mut paths));
+                let slot = *resolutions.entry(path.clone()).or_insert_with(|| {
+                    bundle.resolutions.push((path_id, target_id));
+                    bundle.resolutions.len() - 1
+                });
+                ensure!(
+                    bundle.resolutions[slot] == (path_id, target_id),
+                    "input changed between observations"
+                );
+                record.resolutions.push(slot);
+            }
+            for (path, digest) in &trace.files {
+                let path_id = intern(path, &mut bundle.paths, &mut paths);
+                let slot = *files.entry(path.clone()).or_insert_with(|| {
+                    bundle.files.push((path_id, digest.clone()));
+                    bundle.files.len() - 1
+                });
+                ensure!(
+                    bundle.files[slot] == (path_id, digest.clone()),
+                    "file changed between observations"
+                );
+                record.files.push(slot);
+            }
+            bundle.records.insert(key(action)?, record);
+        }
+        Ok(bundle)
+    }
+
+    fn validate(&self, action: &Action, view: &ReadView) -> Result<bool> {
+        let Some(record) = self.records.get(&key(action)?) else {
+            return Ok(false);
+        };
+        let paths: Option<Vec<_>> = record
+            .dependencies
+            .iter()
+            .map(|id| self.paths.get(*id).cloned())
+            .collect();
+        if paths != action.expected {
+            return Ok(false);
+        }
+        for slot in &record.resolutions {
+            let (path, target) = self
+                .resolutions
+                .get(*slot)
+                .ok_or_else(|| anyhow::anyhow!("invalid resolution index"))?;
+            let path = self
+                .paths
+                .get(*path)
+                .ok_or_else(|| anyhow::anyhow!("invalid path index"))?;
+            let target = target
+                .map(|id| {
+                    self.paths
+                        .get(id)
+                        .cloned()
+                        .ok_or_else(|| anyhow::anyhow!("invalid target index"))
+                })
+                .transpose()?;
+            if view.resolve(path)? != target {
+                return Ok(false);
+            }
+        }
+        for slot in &record.files {
+            let (path, digest) = self
+                .files
+                .get(*slot)
+                .ok_or_else(|| anyhow::anyhow!("invalid file index"))?;
+            let path = self
+                .paths
+                .get(*path)
+                .ok_or_else(|| anyhow::anyhow!("invalid content path index"))?;
+            if &view.fingerprint(path)? != digest {
+                return Ok(false);
+            }
+        }
+        Ok(true)
+    }
+}
+
+fn build_files(root: &Path, files: &mut Vec<PathBuf>) -> Result<()> {
+    for entry in fs::read_dir(root)? {
+        let entry = entry?;
+        if entry.file_name().to_string_lossy().starts_with("meson-") {
+            continue;
+        }
+        if entry.file_type()?.is_dir() {
+            build_files(&entry.path(), files)?;
+        } else if entry.file_type()?.is_file() {
+            files.push(entry.path());
+        }
+    }
+    Ok(())
+}
+
+fn fresh(action: &Action) -> Result<()> {
+    let paths = retrieve_c_includes(&action.command, action.seeds.clone(), None)?;
+    ensure!(
+        Some(paths) == action.expected,
+        "fresh result changed for {}",
+        action.file.display()
+    );
+    Ok(())
+}
+
+fn tree_fingerprint(root: &Path) -> Result<(String, usize, usize)> {
+    fn visit(path: &Path, hash: &mut Sha256, files: &mut usize, bytes: &mut usize) -> Result<()> {
+        let mut entries = fs::read_dir(path)?.collect::<std::io::Result<Vec<_>>>()?;
+        entries.sort_by_key(|entry| entry.file_name());
+        for entry in entries {
+            let name = entry
+                .file_name()
+                .into_string()
+                .map_err(|_| anyhow::anyhow!("non-utf8 tree path"))?;
+            hash.update(name.len().to_le_bytes());
+            hash.update(name.as_bytes());
+            let kind = entry.file_type()?;
+            if kind.is_dir() {
+                hash.update(b"d");
+                visit(&entry.path(), hash, files, bytes)?;
+                hash.update(b"e");
+            } else if kind.is_symlink() {
+                hash.update(b"l");
+                hash.update(serde_json::to_vec(&(
+                    fs::read_link(entry.path())?,
+                    entry.path().canonicalize().ok(),
+                ))?);
+            } else if kind.is_file() {
+                hash.update(b"f");
+                let mut file = fs::File::open(entry.path())?;
+                hash.update(file.metadata()?.len().to_le_bytes());
+                let mut buffer = [0; 65536];
+                loop {
+                    let count = file.read(&mut buffer)?;
+                    if count == 0 {
+                        break;
+                    }
+                    hash.update(&buffer[..count]);
+                    *bytes += count;
+                }
+                *files += 1;
+            } else {
+                bail!("unsupported tree file type");
+            }
+        }
+        Ok(())
+    }
+    let mut hash = Sha256::new();
+    let (mut files, mut bytes) = (0, 0);
+    visit(root, &mut hash, &mut files, &mut bytes)?;
+    Ok((format!("{:x}", hash.finalize()), files, bytes))
+}
+
+fn main() -> Result<()> {
+    let args: Vec<_> = std::env::args_os().skip(1).collect();
+    if !(2..=3).contains(&args.len()) {
+        bail!("usage: trace_cost VIEW.json OUTPUT_DIRECTORY [REPETITIONS]");
+    }
+    let marker = Path::new(&args[0]).canonicalize()?;
+    let control = marker.parent().unwrap();
+    let descriptor: Descriptor = serde_json::from_slice(&fs::read(&marker)?)?;
+    ensure!(
+        descriptor.schema_version == 1,
+        "unsupported input-view version"
+    );
+    let root = descriptor.root.canonicalize()?;
+    ensure!(root == control.join("inputs"), "input-view root mismatch");
+    let lock = fs::File::options()
+        .read(true)
+        .write(true)
+        .open(control.join("view.lock"))?;
+    lock.try_lock()?;
+    let destination = std::env::current_dir()?.join(&args[1]);
+    ensure!(
+        !destination.starts_with(&root),
+        "measurement output is inside input view"
+    );
+    fs::create_dir(&destination)?;
+    let destination = destination.canonicalize()?;
+    ensure!(
+        !destination.starts_with(&root),
+        "measurement output is inside input view"
+    );
+    let repetitions = args
+        .get(2)
+        .map(|value| value.to_str().unwrap().parse())
+        .transpose()?
+        .unwrap_or(3usize);
+    ensure!(repetitions > 0, "repetitions must be positive");
+    let build = root.join("build");
+    std::env::set_current_dir(&build)?;
+    let commands: Vec<CompileCommand> =
+        serde_json::from_slice(&fs::read(build.join("compile_commands.json"))?)?;
+    let mut seeds = Vec::new();
+    build_files(&build, &mut seeds)?;
+    seeds.sort();
+    let observed = Arc::new(ReadView::new(&root, &build)?);
+    let mut actions = Vec::new();
+    for entry in commands {
+        ensure!(
+            entry.directory.canonicalize()? == build,
+            "mixed compilation directories"
+        );
+        let command = match (entry.command, entry.arguments) {
+            (Some(command), _) => command,
+            (None, Some(arguments)) => shell_words::join(arguments),
+            _ => bail!("missing compiler command"),
+        };
+        let mut files = seeds.clone();
+        files.push(entry.file.clone());
+        files.sort();
+        files.dedup();
+        let mut action = Action {
+            file: entry.file,
+            command,
+            seeds: files,
+            expected: None,
+            trace: None,
+            error: None,
+        };
+        match retrieve_c_includes(&action.command, action.seeds.clone(), None) {
+            Ok(expected) => {
+                match retrieve_c_includes_observed(
+                    &action.command,
+                    action.seeds.clone(),
+                    observed.clone(),
+                ) {
+                    Ok((paths, trace)) => {
+                        ensure!(
+                            paths == expected,
+                            "observed discovery differs for {}",
+                            action.file.display()
+                        );
+                        action.trace = Some(trace);
+                    }
+                    Err(error) => action.error = Some(format!("observation fallback: {error:#}")),
+                }
+                action.expected = Some(expected);
+            }
+            Err(error) => action.error = Some(format!("baseline unavailable: {error:#}")),
+        }
+        actions.push(action);
+    }
+    let start = Instant::now();
+    let payload = serde_json::to_vec(&actions)?;
+    let digest = Sha256::digest(&payload);
+    fs::write(destination.join("traces.tmp"), &payload)?;
+    fs::rename(
+        destination.join("traces.tmp"),
+        destination.join("traces.json"),
+    )?;
+    let publication_ns = start.elapsed().as_nanos();
+    let local = control.join(format!("trace-cost-{}", std::process::id()));
+    fs::create_dir(&local)?;
+    fs::write(local.join("plain.json"), &payload)?;
+    let start = Instant::now();
+    let shared = SharedBundle::pack(&actions)?;
+    let packed = serde_json::to_vec(&shared)?;
+    let packed_digest = Sha256::digest(&packed);
+    fs::write(local.join("shared.tmp"), &packed)?;
+    fs::rename(local.join("shared.tmp"), local.join("shared.json"))?;
+    let shared_publication_ns = start.elapsed().as_nanos();
+    let expected_tree = tree_fingerprint(&root)?;
+    let mut report = json!({
+        "schema_version": 1, "mode": "measurement-only; no build reuse",
+        "input_view": serde_json::from_slice::<serde_json::Value>(&fs::read(marker)?)?,
+        "actions": actions.len(), "available": actions.iter().filter(|a| a.expected.is_some()).count(),
+        "observed": actions.iter().filter(|a| a.trace.is_some()).count(),
+        "build_seeds": seeds.len(), "payload_bytes": payload.len(), "publication_ns": publication_ns,
+        "shared_payload_bytes": packed.len(), "shared_publication_ns": shared_publication_ns,
+        "validation_storage": local,
+        "whole_tree": {"sha256": expected_tree.0, "files": expected_tree.1, "bytes": expected_tree.2, "scope": "owned-tree cost only; external-store guards are not measured"},
+        "preparation_stats": observed.stats(), "runs": [],
+    });
+    fs::write(
+        destination.join("result.json"),
+        serde_json::to_vec_pretty(&report)?,
+    )?;
+    for round in 0..repetitions {
+        let mut modes = [
+            "fresh",
+            "observed",
+            "validation-plain",
+            "validation-shared",
+            "whole-tree",
+        ];
+        modes.rotate_left(round % 5);
+        for mode in modes {
+            let view = Arc::new(ReadView::new(&root, &build)?);
+            let start = Instant::now();
+            if mode == "whole-tree" {
+                ensure!(
+                    tree_fingerprint(&root)? == expected_tree,
+                    "owned tree changed"
+                );
+                let elapsed_ns = start.elapsed().as_nanos();
+                report["runs"]
+                    .as_array_mut()
+                    .unwrap()
+                    .push(json!({"round": round, "mode": mode, "elapsed_ns": elapsed_ns}));
+                fs::write(
+                    destination.join("result.json"),
+                    serde_json::to_vec_pretty(&report)?,
+                )?;
+                eprintln!("{round} {mode}: {:.6}s", elapsed_ns as f64 / 1e9);
+                continue;
+            }
+            let decoded;
+            let packed;
+            let current = if mode == "validation-plain" {
+                let bytes = fs::read(local.join("plain.json"))?;
+                ensure!(Sha256::digest(&bytes) == digest, "trace payload changed");
+                decoded = serde_json::from_slice::<Vec<Action>>(&bytes)?;
+                &decoded
+            } else {
+                &actions
+            };
+            let shared = if mode == "validation-shared" {
+                let bytes = fs::read(local.join("shared.json"))?;
+                ensure!(
+                    Sha256::digest(&bytes) == packed_digest,
+                    "shared payload changed"
+                );
+                packed = serde_json::from_slice::<SharedBundle>(&bytes)?;
+                Some(&packed)
+            } else {
+                None
+            };
+            let mut fallbacks = 0;
+            for action in current.iter().filter(|action| action.expected.is_some()) {
+                match mode {
+                    "fresh" => fresh(action)?,
+                    "observed" => match retrieve_c_includes_observed(
+                        &action.command,
+                        action.seeds.clone(),
+                        view.clone(),
+                    ) {
+                        Ok((paths, _)) => {
+                            ensure!(Some(paths) == action.expected, "observed result changed")
+                        }
+                        Err(_) => {
+                            fallbacks += 1;
+                            fresh(action)?;
+                        }
+                    },
+                    "validation-plain" => {
+                        let valid = action
+                            .trace
+                            .as_ref()
+                            .is_some_and(|trace| view.validate(trace).unwrap_or(false));
+                        if !valid {
+                            fallbacks += 1;
+                            fresh(action)?;
+                        }
+                    }
+                    "validation-shared" => {
+                        if !shared.unwrap().validate(action, &view)? {
+                            fallbacks += 1;
+                            fresh(action)?;
+                        }
+                    }
+                    _ => unreachable!(),
+                }
+            }
+            let elapsed_ns = start.elapsed().as_nanos();
+            report["runs"].as_array_mut().unwrap().push(json!({"round": round, "mode": mode, "elapsed_ns": elapsed_ns, "fallbacks": fallbacks, "stats": view.stats()}));
+            fs::write(
+                destination.join("result.json"),
+                serde_json::to_vec_pretty(&report)?,
+            )?;
+            eprintln!(
+                "{round} {mode}: {:.6}s, {fallbacks} fallbacks",
+                elapsed_ns as f64 / 1e9
+            );
+        }
+    }
+    fs::write(destination.join("shared-traces.json"), &packed)?;
+    report["passed"] = json!(true);
+    fs::write(
+        destination.join("result.json"),
+        serde_json::to_vec_pretty(&report)?,
+    )?;
+    Ok(())
+}
