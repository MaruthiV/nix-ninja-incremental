+#[cfg(test)]
+mod resolver_tests {
+    use super::*;
+    use std::fs;
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    static NEXT_ID: AtomicU64 = AtomicU64::new(0);
+
+    struct Fixture(PathBuf);
+
+    impl Fixture {
+        fn new() -> Self {
+            let id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+            let root =
+                std::env::temp_dir().join(format!("nix-ninja-paths-{}-{id}", std::process::id()));
+            fs::create_dir(&root).unwrap();
+            Self(root.canonicalize().unwrap())
+        }
+
+        fn path(&self, name: &str) -> PathBuf {
+            self.0.join(name)
+        }
+
+        fn write(&self, name: &str, contents: &str) -> PathBuf {
+            let path = self.path(name);
+            fs::create_dir_all(path.parent().unwrap()).unwrap();
+            fs::write(&path, contents).unwrap();
+            path
+        }
+    }
+
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.0);
+        }
+    }
+
+    fn scan(command: &str, source: &Path) -> HashSet<PathBuf> {
+        retrieve_c_includes(command, vec![source.to_owned()], None)
+            .unwrap()
+            .into_iter()
+            .collect()
+    }
+
+    #[test]
+    fn new_header_is_seen_by_next_scan() {
+        let fixture = Fixture::new();
+        let source = fixture.write("main.c", "#include \"value.h\"\n");
+        assert_eq!(
+            scan("cc -c main.c", &source),
+            HashSet::from([source.clone()])
+        );
+        let header = fixture.write("value.h", "#define VALUE 1\n");
+        assert_eq!(
+            scan("cc -c main.c", &source),
+            HashSet::from([source, header])
+        );
+    }
+
+    #[test]
+    fn earlier_include_directory_is_checked_again() {
+        let fixture = Fixture::new();
+        let source = fixture.write("main.c", "#include <value.h>\n");
+        fs::create_dir(fixture.path("early")).unwrap();
+        let late = fixture.write("late/value.h", "#define VALUE 1\n");
+        let command = shell_words::join([
+            "cc".to_owned(),
+            format!("-I{}", fixture.path("early").display()),
+            format!("-I{}", fixture.path("late").display()),
+        ]);
+        assert_eq!(
+            scan(&command, &source),
+            HashSet::from([source.clone(), late])
+        );
+        let early = fixture.write("early/value.h", "#define VALUE 2\n");
+        assert_eq!(scan(&command, &source), HashSet::from([source, early]));
+    }
+
+    #[test]
+    fn removed_header_is_not_retained() {
+        let fixture = Fixture::new();
+        let source = fixture.write("main.c", "#include \"value.h\"\n");
+        let header = fixture.write("value.h", "#define VALUE 1\n");
+        assert_eq!(
+            scan("cc -c main.c", &source),
+            HashSet::from([source.clone(), header.clone()])
+        );
+        fs::remove_file(header).unwrap();
+        assert_eq!(scan("cc -c main.c", &source), HashSet::from([source]));
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn symlink_target_is_resolved_again() {
+        let fixture = Fixture::new();
+        let source = fixture.write("main.c", "#include \"value.h\"\n");
+        let old = fixture.write("old.h", "#define VALUE 1\n");
+        let new = fixture.write("new.h", "#define VALUE 2\n");
+        let link = fixture.path("value.h");
+        std::os::unix::fs::symlink(&old, &link).unwrap();
+        assert_eq!(
+            scan("cc -c main.c", &source),
+            HashSet::from([source.clone(), old])
+        );
+        fs::remove_file(&link).unwrap();
+        std::os::unix::fs::symlink(&new, &link).unwrap();
+        assert_eq!(scan("cc -c main.c", &source), HashSet::from([source, new]));
+    }
+
+    #[test]
+    fn virtual_paths_take_precedence() {
+        let fixture = Fixture::new();
+        let logical = fixture.path("missing.h");
+        assert_eq!(canonicalize_cached(logical.clone(), None).unwrap(), None);
+        let old = fixture.write("old.h", "#define VALUE 1\n");
+        let new = fixture.write("new.h", "#define VALUE 2\n");
+        for actual in [old, new] {
+            let mapping = HashMap::from([(logical.clone(), actual.clone())]);
+            assert_eq!(
+                canonicalize_cached(logical.clone(), Some(&mapping)).unwrap(),
+                Some(actual)
+            );
+        }
+    }
+}
