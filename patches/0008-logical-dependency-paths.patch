-type PathCache = Arc<RwLock<HashMap<PathBuf, Option<PathBuf>>>>;
+#[derive(Clone, Default)]
+struct PathCache {
+    paths: Arc<RwLock<HashMap<PathBuf, Option<PathBuf>>>>,
+    preserve_paths: bool,
+}
+
+impl PathCache {
+    fn build_paths() -> Self {
+        Self {
+            preserve_paths: true,
+            ..Self::default()
+        }
+    }
+}
+
+fn resolve_for_scan(
+    path: PathBuf,
+    virtual_paths: Option<&HashMap<PathBuf, PathBuf>>,
+    path_cache: &PathCache,
+    observer: Option<&Arc<Recorder>>,
+) -> Result<Option<PathBuf>> {
+    let Some(resolved) =
+        canonicalize_with_cache(path.clone(), virtual_paths, path_cache, observer)?
+    else {
+        return Ok(None);
+    };
+    if !path_cache.preserve_paths {
+        return Ok(Some(resolved));
+    }
+    let mut normalized = PathBuf::new();
+    for component in path.components() {
+        match component {
+            Component::CurDir => {}
+            Component::ParentDir if normalized.file_name().is_some_and(|name| name != "..") => {
+                normalized.pop();
+            }
+            _ => normalized.push(component.as_os_str()),
+        }
+    }
+    if normalized != path {
+        ensure!(
+            canonicalize_with_cache(normalized.clone(), virtual_paths, path_cache, observer)?
+                .as_ref()
+                == Some(&resolved),
+            "parent traversal through a directory alias is unsupported: {}",
+            path.display()
+        );
+    }
+    Ok(Some(normalized))
+}
 
