diff --git a/crates/nix-ninja/src/profile.rs b/crates/nix-ninja/src/profile.rs
new file mode 100644
index 0000000..c57de15
--- /dev/null
+++ b/crates/nix-ninja/src/profile.rs
@@ -0,0 +1,97 @@
+use anyhow::{ensure, Context, Result};
+use serde::Serialize;
+use std::collections::BTreeMap;
+use std::fs::{File, OpenOptions};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{LazyLock, Mutex};
+use std::time::Instant;
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+static METRICS: LazyLock<Mutex<BTreeMap<&'static str, Metric>>> = LazyLock::new(Mutex::default);
+
+#[derive(Default, Serialize)]
+struct Metric {
+    calls: u64,
+    elapsed_ns: u128,
+}
+
+pub struct Span {
+    name: &'static str,
+    start: Option<Instant>,
+}
+
+pub fn span(name: &'static str) -> Span {
+    Span {
+        name,
+        start: ENABLED.load(Ordering::Relaxed).then(Instant::now),
+    }
+}
+
+impl Drop for Span {
+    fn drop(&mut self) {
+        if let Some(start) = self.start {
+            let elapsed_ns = start.elapsed().as_nanos();
+            let mut metrics = METRICS.lock().unwrap_or_else(|error| error.into_inner());
+            let metric = metrics.entry(self.name).or_default();
+            metric.calls += 1;
+            metric.elapsed_ns += elapsed_ns;
+        }
+    }
+}
+
+pub struct Report {
+    file: File,
+    start: Instant,
+    build_directory: PathBuf,
+}
+
+pub fn report(build_directory: &Path) -> Result<Option<Report>> {
+    let Some(path) = std::env::var_os("NIX_NINJA_PROFILE") else {
+        return Ok(None);
+    };
+    let path = std::path::absolute(PathBuf::from(path))?;
+    let parent = path
+        .parent()
+        .context("profile needs a parent directory")?
+        .canonicalize()?;
+    let build_directory = build_directory.canonicalize()?;
+    ensure!(
+        !parent.starts_with(&build_directory),
+        "profile must be outside the build directory"
+    );
+    let file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&path)
+        .with_context(|| format!("create profile {}", path.display()))?;
+    METRICS
+        .lock()
+        .unwrap_or_else(|error| error.into_inner())
+        .clear();
+    ENABLED.store(true, Ordering::Relaxed);
+    Ok(Some(Report {
+        file,
+        start: Instant::now(),
+        build_directory,
+    }))
+}
+
+impl Drop for Report {
+    fn drop(&mut self) {
+        ENABLED.store(false, Ordering::Relaxed);
+        let elapsed_ns = self.start.elapsed().as_nanos();
+        let metrics = METRICS.lock().unwrap_or_else(|error| error.into_inner());
+        let value = serde_json::json!({
+            "schema_version": 1,
+            "mode": "planning-profile",
+            "build_directory": self.build_directory,
+            "elapsed_ns": elapsed_ns,
+            "phase_semantics": "inclusive cumulative wall time; concurrent phases overlap",
+            "phases": *metrics,
+        });
+        if let Err(error) = serde_json::to_writer(&mut self.file, &value) {
+            eprintln!("could not write planning profile: {error}");
+        }
+    }
+}
