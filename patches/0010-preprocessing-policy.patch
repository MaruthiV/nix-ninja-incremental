+fn continued_dependency(text: &str) -> bool {
+    let mut joined = String::new();
+    let mut active = false;
+    for line in text.lines() {
+        if let Some(prefix) = line.trim_end().strip_suffix('\\') {
+            joined.push_str(prefix);
+            active = true;
+            continue;
+        }
+        if active {
+            joined.push_str(line);
+            let dependency = DIRECTIVE.captures(&joined).is_some_and(|directive| {
+                matches!(
+                    &directive[1],
+                    "include" | "embed" | "include_next" | "import"
+                )
+            });
+            if dependency || joined.contains("__has_include") || joined.contains("__has_embed") {
+                return true;
+            }
+            joined.clear();
+            active = false;
+        }
+    }
+    false
+}
