+    #[test]
+    fn retained_hits_and_fresh_updates_share_the_record_budget() {
+        let fixture = Fixture::new();
+        let main = fixture.write("main.c", "int value;\n");
+        let context = fixture.context(Mode::Record);
+        fixture.scan(&context);
+        let key = context.state.lock().unwrap().used.first().unwrap().clone();
+        context.finish();
+        drop(context);
+        let context = fixture.context(Mode::Reuse);
+        context.state.lock().unwrap().used =
+            (0..MAX_RECORDS).map(|i| format!("{i:064x}")).collect();
+        assert_eq!(fixture.scan(&context), vec![main.clone()]);
+        assert_eq!(context.report().hits, 0);
+        assert_eq!(context.report().scans, 1);
+        assert_eq!(context.report().bypasses["record-budget"], 1);
+        assert_eq!(context.report().recorded_actions, MAX_RECORDS);
+        drop(context);
+        let context = fixture.context(Mode::Reuse);
+        let mut keys = (0..MAX_RECORDS - 1)
+            .map(|i| format!("{i:064x}"))
+            .collect::<BTreeSet<_>>();
+        keys.insert(key);
+        context.state.lock().unwrap().used = keys;
+        assert_eq!(fixture.scan(&context), vec![main]);
+        assert_eq!(context.report().hits, 1);
+        assert_eq!(context.report().scans, 0);
+        assert_eq!(context.report().recorded_actions, MAX_RECORDS);
+    }
