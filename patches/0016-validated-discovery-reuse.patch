+    #[test]
+    fn reuse_tracks_negative_searches_aliases_commands_and_leaf_kinds() {
+        let fixture = Fixture::new();
+        let main = fixture.write(
+            "main.c",
+            "#include \"alias.h\"\n#if __has_include(<probe.h>)\n#endif\n",
+        );
+        fixture.write("early/keep", "unused");
+        let late = fixture.write("late/probe.h", "not c");
+        fixture.write("first.h", "int value;\n");
+        fixture.write("second.h", "int value;\n");
+        let alias = fixture.cwd().join("alias.h");
+        std::os::unix::fs::symlink("first.h", &alias).unwrap();
+        let command = |reverse: bool| {
+            let directories = if reverse {
+                ["late", "early"]
+            } else {
+                ["early", "late"]
+            };
+            shell_words::join([
+                "cc".into(),
+                format!("-I{}", fixture.cwd().join(directories[0]).display()),
+                format!("-I{}", fixture.cwd().join(directories[1]).display()),
+                "-c".into(),
+                "main.c".into(),
+            ])
+        };
+        let check = |reverse, expected: &Path, hit: bool| {
+            let context = fixture.context(Mode::Reuse);
+            let paths = fixture.scan_command(&context, &command(reverse));
+            assert_eq!(
+                HashSet::from_iter(paths),
+                HashSet::from([main.clone(), alias.clone(), expected.to_owned()])
+            );
+            assert_eq!(context.report().hits, u64::from(hit));
+            assert_eq!(context.report().scans, u64::from(!hit));
+            context.finish();
+        };
+        check(false, &late, false);
+        fixture.write("late/probe.h", "changed leaf data");
+        check(false, &late, true);
+        let early = fixture.write("early/probe.h", "earlier");
+        check(false, &early, false);
+        fs::remove_file(&alias).unwrap();
+        std::os::unix::fs::symlink("second.h", &alias).unwrap();
+        check(false, &early, false);
+        check(true, &late, false);
+        fs::remove_file(&late).unwrap();
+        fs::create_dir(&late).unwrap();
+        check(true, &early, false);
+    }
