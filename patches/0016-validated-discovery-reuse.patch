+    #[test]
+    fn reuse_skips_scans_and_retains_records_across_publications() {
+        let fixture = Fixture::new();
+        let main = fixture.write("main.c", "#include \"value.h\"\n");
+        let header = fixture.write("value.h", "int value;\n");
+        let expected = HashSet::from([main, header.clone()]);
+        let context = fixture.context(Mode::Reuse);
+        assert_eq!(HashSet::from_iter(fixture.scan(&context)), expected);
+        assert_eq!(context.report().scans, 1);
+        assert_eq!(context.report().hits, 0);
+        context.finish();
+        drop(context);
+        for _ in 0..3 {
+            let context = fixture.context(Mode::Reuse);
+            assert_eq!(context.report().loaded_records, 1);
+            assert_eq!(HashSet::from_iter(fixture.scan(&context)), expected);
+            assert_eq!(context.report().hits, 1);
+            assert_eq!(context.report().scans, 0);
+            assert_eq!(context.report().validated_candidates, 0);
+            context.finish();
+            assert_eq!(context.report().publication, "published");
+            drop(context);
+        }
+        let before = fs::metadata(&header).unwrap();
+        fixture.write("value.h", "int changed;\n");
+        fs::File::open(&header)
+            .unwrap()
+            .set_times(fs::FileTimes::new().set_modified(before.modified().unwrap()))
+            .unwrap();
+        let context = fixture.context(Mode::Reuse);
+        assert_eq!(HashSet::from_iter(fixture.scan(&context)), expected);
+        assert_eq!(context.report().hits, 0);
+        assert_eq!(context.report().scans, 1);
+    }
