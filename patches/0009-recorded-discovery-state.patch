index 0000000..1c668c1
--- /dev/null
+++ b/crates/nix-ninja/src/discovery_identity.rs
@@ -0,0 +1,241 @@
+use anyhow::{ensure, Result};
+use serde::Serialize;
+use sha2::{Digest, Sha256};
+use std::collections::BTreeMap;
+use std::fs;
+use std::path::{Path, PathBuf};
+
+#[derive(Clone, Serialize)]
+pub struct Namespace {
+    pub code_sha256: String,
+    pub view_id: String,
+    pub root: PathBuf,
+    pub cwd: PathBuf,
+    pub system: String,
+    pub store_dir: PathBuf,
+    pub tools: BTreeMap<String, String>,
+    pub wrapper_vars: BTreeMap<String, String>,
+    pub search_path: String,
+}
+
+pub struct Identity {
+    pub namespace: String,
+}
+
+fn hex(value: &str, length: usize) -> bool {
+    value.len() == length
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+fn fingerprint(value: &impl Serialize) -> Result<String> {
+    Ok(format!("{:x}", Sha256::digest(serde_json::to_vec(value)?)))
+}
+
+pub fn code_digest(path: &Path) -> Result<String> {
+    ensure!(
+        fs::metadata(path)?.is_file(),
+        "scanner binary must be a regular file"
+    );
+    Ok(format!("{:x}", Sha256::digest(fs::read(path)?)))
+}
+
+impl Identity {
+    pub fn new(namespace: &Namespace) -> Result<Self> {
+        ensure!(
+            hex(&namespace.code_sha256, 64) && hex(&namespace.view_id, 32),
+            "invalid discovery namespace identity"
+        );
+        ensure!(
+            namespace.root.is_absolute() && namespace.cwd.starts_with(&namespace.root),
+            "working directory escapes input namespace"
+        );
+        ensure!(
+            namespace.store_dir.is_absolute()
+                && !namespace.system.is_empty()
+                && !namespace.search_path.is_empty(),
+            "incomplete discovery environment"
+        );
+        for name in [
+            "cc",
+            "coreutils",
+            "nix",
+            "nix-ninja",
+            "nix-ninja-task",
+            "patchelf",
+        ] {
+            ensure!(
+                namespace.tools.contains_key(name),
+                "missing tool identity: {name}"
+            );
+        }
+        Ok(Self {
+            namespace: fingerprint(&(1_u32, namespace))?,
+        })
+    }
+
+    pub fn action(&self, command: &str, seeds: &[PathBuf], compiler: &Path) -> Result<String> {
+        ensure!(
+            !command.is_empty() && !seeds.is_empty() && compiler.is_absolute(),
+            "incomplete compilation action"
+        );
+        fingerprint(&(1_u32, &self.namespace, command, seeds, compiler))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    static NEXT_ID: AtomicU64 = AtomicU64::new(0);
+
+    fn namespace() -> Namespace {
+        Namespace {
+            code_sha256: "a".repeat(64),
+            view_id: "b".repeat(32),
+            root: "/tmp/inputs".into(),
+            cwd: "/tmp/inputs/build".into(),
+            system: "x86_64-linux".into(),
+            store_dir: "/nix/store".into(),
+            tools: [
+                "cc",
+                "coreutils",
+                "nix",
+                "nix-ninja",
+                "nix-ninja-task",
+                "patchelf",
+            ]
+            .into_iter()
+            .map(|name| (name.to_owned(), format!("/nix/store/tool-{name}")))
+            .collect(),
+            wrapper_vars: BTreeMap::from([("NIX_HARDENING_ENABLE".into(), "fortify".into())]),
+            search_path: "/nix/store/cc/bin:/nix/store/coreutils/bin".into(),
+        }
+    }
+
+    fn action(namespace: &Namespace) -> String {
+        Identity::new(namespace)
+            .unwrap()
+            .action(
+                "cc -Iearly -Ilate -c main.c",
+                &["main.c".into(), "config.h".into()],
+                Path::new("/nix/store/cc/bin/cc"),
+            )
+            .unwrap()
+    }
+
+    #[test]
+    fn changed_environment_tool_code_or_view_cannot_share_records() {
+        let baseline = namespace();
+        let expected = action(&baseline);
+        let mut changes = Vec::new();
+        let mut changed = baseline.clone();
+        changed.code_sha256 = "c".repeat(64);
+        changes.push(changed);
+        let mut changed = baseline.clone();
+        changed.view_id = "d".repeat(32);
+        changes.push(changed);
+        let mut changed = baseline.clone();
+        changed.root = "/other/inputs".into();
+        changed.cwd = "/other/inputs/build".into();
+        changes.push(changed);
+        let mut changed = baseline.clone();
+        changed.cwd = "/tmp/inputs/nested".into();
+        changes.push(changed);
+        let mut changed = baseline.clone();
+        changed.system = "aarch64-linux".into();
+        changes.push(changed);
+        let mut changed = baseline.clone();
+        changed.store_dir = "/other/store".into();
+        changes.push(changed);
+        let mut changed = baseline.clone();
+        changed
+            .tools
+            .insert("cc".into(), "/nix/store/other-cc".into());
+        changes.push(changed);
+        let mut changed = baseline.clone();
+        changed
+            .wrapper_vars
+            .insert("NIX_CFLAGS_COMPILE".into(), "-include config.h".into());
+        changes.push(changed);
+        let mut changed = baseline.clone();
+        changed.search_path = "/nix/store/other/bin".into();
+        changes.push(changed);
+        for changed in changes {
+            assert_ne!(action(&changed), expected);
+        }
+        assert_eq!(action(&namespace()), expected);
+    }
+
+    #[test]
+    fn command_order_seed_boundaries_and_compiler_resolution_are_distinct() {
+        let identity = Identity::new(&namespace()).unwrap();
+        let compiler = Path::new("/nix/store/cc/bin/cc");
+        let seeds = vec!["main.c".into(), "config.h".into()];
+        let expected = identity.action("cc -Ia -Ib", &seeds, compiler).unwrap();
+        assert_ne!(
+            identity.action("cc -Ib -Ia", &seeds, compiler).unwrap(),
+            expected
+        );
+        assert_ne!(
+            identity
+                .action(
+                    "cc -Ia -Ib",
+                    &["config.h".into(), "main.c".into()],
+                    compiler
+                )
+                .unwrap(),
+            expected
+        );
+        assert_ne!(
+            identity
+                .action("cc -Ia -Ib", &["main.cconfig.h".into()], compiler)
+                .unwrap(),
+            expected
+        );
+        assert_ne!(
+            identity
+                .action("cc -Ia -Ib", &seeds, Path::new("/nix/store/other/bin/cc"))
+                .unwrap(),
+            expected
+        );
+        assert_ne!(
+            identity
+                .action("cc", &["a".into(), "bc".into()], compiler)
+                .unwrap(),
+            identity
+                .action("cc", &["ab".into(), "c".into()], compiler)
+                .unwrap()
+        );
+    }
+
+    #[test]
+    fn actual_binary_bytes_control_code_identity() {
+        let id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+        let path = std::env::temp_dir().join(format!("nni-code-{}-{id}", std::process::id()));
+        fs::write(&path, b"first binary").unwrap();
+        let first = code_digest(&path).unwrap();
+        fs::write(&path, b"other binary").unwrap();
+        assert_ne!(code_digest(&path).unwrap(), first);
+        fs::remove_file(path).unwrap();
+    }
+
+    #[test]
+    fn partial_or_outside_namespace_is_rejected() {
+        let mut value = namespace();
+        value.code_sha256 = "unknown".into();
+        assert!(Identity::new(&value).is_err());
+        let mut value = namespace();
+        value.cwd = "/tmp/elsewhere".into();
+        assert!(Identity::new(&value).is_err());
+        let mut value = namespace();
+        value.tools.remove("cc");
+        assert!(Identity::new(&value).is_err());
+        assert!(Identity::new(&namespace())
+            .unwrap()
+            .action("cc", &[], Path::new("cc"))
+            .is_err());
+    }
+}
diff --git a/crates/nix-ninja/src/discovery_policy.rs b/crates/nix-ninja/src/discovery_policy.rs
new file mode 100644
index 0000000..1b6513f
--- /dev/null
+++ b/crates/nix-ninja/src/discovery_policy.rs
@@ -0,0 +1,455 @@
+use deps_infer::observations::{DiscoveryTrace, ReadView};
+use n2::canon;
+use regex::Regex;
+use std::collections::{BTreeMap, HashMap, HashSet};
+use std::path::{Path, PathBuf};
+use std::sync::LazyLock;
+
+type Check<T> = Result<T, &'static str>;
+
+pub struct CommandInputs<'a> {
+    pub command: &'a str,
+    pub seeds: &'a [PathBuf],
+    pub cwd: &'a Path,
+    pub compiler: &'a Path,
+    pub store_inputs: &'a [PathBuf],
+    pub wrapper_vars: &'a BTreeMap<String, String>,
+    pub ambient_search: bool,
+}
+
+pub struct Policy {
+    pub trace: DiscoveryTrace,
+}
+
+fn normalized(path: &Path) -> Check<PathBuf> {
+    let mut value = path.to_str().ok_or("non-utf8-path")?.to_owned();
+    canon::canonicalize_path(&mut value);
+    Ok(value.into())
+}
+
+fn guarded(path: &Path, roots: &[PathBuf]) -> bool {
+    path.starts_with("/nix/store")
+        && roots
+            .iter()
+            .any(|root| root.parent() == Some(Path::new("/nix/store")) && path.starts_with(root))
+}
+
+fn observe(
+    path: &Path,
+    action: &CommandInputs<'_>,
+    view: &ReadView,
+    trace: &mut DiscoveryTrace,
+) -> Check<Option<PathBuf>> {
+    let path = action.cwd.join(path);
+    let found = view.resolve(&path).map_err(|_| "unobservable-search")?;
+    trace.resolutions.insert(path, found.clone());
+    Ok(found)
+}
+
+fn flags(
+    args: &[String],
+    wrapper: bool,
+    action: &CommandInputs<'_>,
+    view: &ReadView,
+    trace: &mut DiscoveryTrace,
+    includes: &mut Vec<PathBuf>,
+    forced: &mut Vec<PathBuf>,
+) -> Check<()> {
+    let mut index = 0;
+    while index < args.len() {
+        let arg = &args[index];
+        if arg.starts_with("--embed-dir") && !arg.starts_with("--embed-dir=") {
+            return Err("unsupported-include-mode");
+        }
+        if arg.starts_with('@') {
+            return Err("response-file");
+        }
+        if arg.starts_with("-fmodule")
+            || arg.starts_with("-finput-charset")
+            || arg.starts_with("-fpreprocessed")
+            || arg.starts_with("-Wp,")
+            || matches!(
+                arg.as_str(),
+                "-Xpreprocessor" | "-Xclang" | "-nostdinc" | "-nostdinc++"
+            )
+            || arg.starts_with("--sysroot")
+            || arg.starts_with("-isysroot")
+            || arg.starts_with("-B")
+        {
+            return Err("unsupported-preprocessor-mode");
+        }
+        let (kind, value) = if matches!(arg.as_str(), "-I" | "-include" | "-isystem" | "-x") {
+            index += 1;
+            (
+                arg.as_str(),
+                Some(args.get(index).ok_or("missing-flag-value")?.as_str()),
+            )
+        } else if let Some(value) = arg.strip_prefix("-isystem") {
+            ("-isystem", Some(value))
+        } else if let Some(value) = arg.strip_prefix("-include") {
+            ("-include", Some(value))
+        } else if let Some(value) = arg.strip_prefix("-I") {
+            ("-I", Some(value))
+        } else if arg.starts_with("-i") {
+            return Err("unsupported-include-mode");
+        } else {
+            ("", None)
+        };
+        if let Some(value) = value {
+            match kind {
+                "-I" => {
+                    if wrapper || value.starts_with('=') || value == "-" {
+                        return Err("unsupported-include-mode");
+                    }
+                    includes.push(PathBuf::from(value));
+                }
+                "-include" => {
+                    if value.starts_with("-pch") {
+                        return Err("unsupported-preprocessor-mode");
+                    }
+                    forced.push(PathBuf::from(value));
+                }
+                "-isystem" => {
+                    let resolved = observe(Path::new(value), action, view, trace)?
+                        .ok_or("missing-system-root")?;
+                    if !guarded(&resolved, action.store_inputs) || !resolved.is_dir() {
+                        return Err("unguarded-system-root");
+                    }
+                }
+                "-x" if !matches!(value, "c" | "c++" | "none") => {
+                    return Err("unsupported-language")
+                }
+                _ => {}
+            }
+        }
+        if wrapper && arg.starts_with("--embed-dir") {
+            return Err("unmodeled-wrapper-search");
+        }
+        index += 1;
+    }
+    Ok(())
+}
+
+pub fn command(action: &CommandInputs<'_>, view: &ReadView) -> Check<Policy> {
+    if action.ambient_search {
+        return Err("ambient-compiler-search");
+    }
+    if action.command.contains(['$', '`', ';', '&', '|', '<', '>']) {
+        return Err("compound-command");
+    }
+    let args = shell_words::split(action.command).map_err(|_| "command-syntax")?;
+    let program = args
+        .first()
+        .and_then(|arg| Path::new(arg).file_name())
+        .and_then(|name| name.to_str())
+        .ok_or("missing-compiler")?;
+    if !matches!(program, "cc" | "c++" | "gcc" | "g++")
+        || !guarded(action.compiler, action.store_inputs)
+    {
+        return Err("unguarded-compiler");
+    }
+    let mut trace = DiscoveryTrace::default();
+    let mut includes = vec![PathBuf::from(".")];
+    let mut forced = Vec::new();
+    flags(
+        &args[1..],
+        false,
+        action,
+        view,
+        &mut trace,
+        &mut includes,
+        &mut forced,
+    )?;
+    for (key, value) in action.wrapper_vars {
+        if key.starts_with("NIX_CFLAGS_COMPILE") {
+            let args = shell_words::split(value).map_err(|_| "wrapper-syntax")?;
+            flags(
+                &args,
+                true,
+                action,
+                view,
+                &mut trace,
+                &mut includes,
+                &mut forced,
+            )?;
+        }
+    }
+    if !forced.is_empty() {
+        let seeds = action
+            .seeds
+            .iter()
+            .map(|path| normalized(&action.cwd.join(path)))
+            .collect::<Check<HashSet<_>>>()?;
+        for file in forced {
+            let mut found = false;
+            for directory in &includes {
+                let candidate = directory.join(&file);
+                if let Some(target) = observe(&candidate, action, view, &mut trace)? {
+                    if !target.is_file() {
+                        return Err("forced-header-not-regular");
+                    }
+                    let logical = normalized(&action.cwd.join(&candidate))?;
+                    if !seeds.contains(&logical) {
+                        return Err("forced-header-not-seeded");
+                    }
+                    if observe(&logical, action, view, &mut trace)?.as_ref() != Some(&target) {
+                        return Err("forced-header-alias-traversal");
+                    }
+                    found = true;
+                    break;
+                }
+            }
+            if !found {
+                return Err("forced-header-not-seeded");
+            }
+        }
+    }
+    Ok(Policy { trace })
+}
+
+static DIRECTIVE: LazyLock<Regex> =
+    LazyLock::new(|| Regex::new(r"^\s*#\s*([a-zA-Z_][a-zA-Z_0-9]*)").unwrap());
+static LITERAL: LazyLock<Regex> =
+    LazyLock::new(|| Regex::new(r##"^\s*#\s*(include|embed)\s*("[^"\n]+"|<[^>\n]+>)"##).unwrap());
+static QUERY: LazyLock<Regex> = LazyLock::new(|| {
+    Regex::new(r##"__has_(include|embed)\s*\(\s*("[^"\n]+"|<[^>\n]+>)\s*\)"##).unwrap()
+});
+static QUERY_START: LazyLock<Regex> =
+    LazyLock::new(|| Regex::new(r"__has_(include|embed)\s*\(").unwrap());
+
+fn source(bytes: &[u8]) -> Check<()> {
+    let text = std::str::from_utf8(bytes).map_err(|_| "non-utf8-source")?;
+    if text.contains("??") {
+        return Err("unmodeled-source-transform");
+    }
+    if text.contains("__has_include_next") {
+        return Err("include-next");
+    }
+    let mut literals = HashSet::new();
+    for line in text.lines() {
+        let directive = DIRECTIVE.captures(line);
+        if let Some(directive) = directive {
+            match directive.get(1).unwrap().as_str() {
+                "include" | "embed" => {
+                    let literal = LITERAL.captures(line).ok_or("computed-dependency")?;
+                    let name = &literal[2];
+                    if name[1..name.len() - 1].contains(['"', '>']) {
+                        return Err("unmodeled-header-name");
+                    }
+                    literals.insert((literal[1].to_owned(), literal[2].to_owned()));
+                }
+                "include_next" | "import" => return Err("unsupported-directive"),
+                word if line.trim_end().ends_with('\\')
+                    && (word.starts_with("inc")
+                        || word.starts_with("emb")
+                        || word.starts_with("imp")) =>
+                {
+                    return Err("continued-directive")
+                }
+                "pragma" if line.contains("pch") => return Err("unsupported-preprocessor-mode"),
+                _ => {}
+            }
+        } else if line.contains('#')
+            && ["include", "embed", "import"]
+                .iter()
+                .any(|word| line.contains(word))
+        {
+            return Err("unmodeled-directive-spelling");
+        }
+    }
+    let queries: Vec<_> = QUERY.captures_iter(text).collect();
+    if queries.len() != QUERY_START.find_iter(text).count() {
+        return Err("computed-query");
+    }
+    for query in queries {
+        if !literals.contains(&(query[1].to_owned(), query[2].to_owned())) {
+            return Err("unobserved-existence-query");
+        }
+    }
+    Ok(())
+}
+
+#[derive(Default)]
+pub struct FilePolicy {
+    checked: HashMap<PathBuf, Check<()>>,
+}
+
+impl FilePolicy {
+    pub fn trace(&mut self, view: &ReadView, trace: &DiscoveryTrace) -> Check<()> {
+        for path in trace.files.keys() {
+            let checked = self.checked.entry(path.clone()).or_insert_with(|| {
+                let bytes = view.bytes(path).map_err(|_| "unobservable-source")?;
+                source(&bytes)
+            });
+            (*checked)?;
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use deps_infer::c_include_parser::retrieve_c_dependency_paths_observed;
+    use std::fs;
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::sync::Arc;
+
+    static NEXT_ID: AtomicU64 = AtomicU64::new(0);
+
+    struct Fixture(PathBuf);
+    impl Fixture {
+        fn new() -> Self {
