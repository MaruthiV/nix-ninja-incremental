+use anyhow::{ensure, Context, Result};
+use deps_infer::observations::{DiscoveryTrace, ReadView};
+use serde::{Deserialize, Serialize};
+use std::collections::{BTreeMap, BTreeSet, HashMap};
+use std::path::{Path, PathBuf};
+
+const MAX_PATHS: usize = 1_000_000;
+const MAX_OBSERVATIONS: usize = 2_000_000;
+pub const MAX_RECORDS: usize = 16_384;
+
+pub struct Recorded {
+    pub dependencies: Vec<PathBuf>,
+    pub trace: DiscoveryTrace,
+}
+
+impl Recorded {
+    pub fn estimated_bytes(&self) -> usize {
+        let path_bytes = |path: &Path| path.as_os_str().as_encoded_bytes().len().saturating_add(64);
+        let dependencies = self.dependencies.iter().map(|path| path_bytes(path));
+        let resolutions = self.trace.resolutions.iter().map(|(path, target)| {
+            path_bytes(path).saturating_add(target.as_deref().map(path_bytes).unwrap_or(0))
+        });
+        let files = self.trace.files.iter().map(|(path, hash)| {
+            path_bytes(path)
+                .saturating_add(hash.len())
+                .saturating_add(64)
+        });
+        dependencies
+            .chain(resolutions)
+            .chain(files)
+            .fold(128, usize::saturating_add)
+    }
+}
+
+#[derive(Serialize, Deserialize)]
+struct Entry {
+    key: String,
+    dependencies: Vec<u32>,
+    resolutions: Vec<u32>,
+    files: Vec<u32>,
+}
+
+#[derive(Serialize, Deserialize)]
+pub struct Bundle {
+    version: u32,
+    paths: Vec<PathBuf>,
+    resolutions: Vec<(u32, Option<u32>)>,
+    files: Vec<(u32, String)>,
+    records: BTreeMap<String, Entry>,
+}
+
+#[derive(Serialize)]
+pub struct Counts {
+    pub paths: usize,
+    pub resolutions: usize,
+    pub files: usize,
+    pub records: usize,
+}
+
+fn digest(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+impl Bundle {
+    pub fn empty() -> Self {
+        Self {
+            version: 1,
+            paths: Vec::new(),
+            resolutions: Vec::new(),
+            files: Vec::new(),
+            records: BTreeMap::new(),
+        }
+    }
+
+    pub fn decode(payload: &str) -> Result<Self> {
+        let bundle: Self = serde_json::from_str(payload)?;
+        bundle.check()?;
+        Ok(bundle)
+    }
+
+    pub fn encode(&self) -> Result<String> {
+        self.check()?;
+        Ok(serde_json::to_string(self)?)
+    }
+
+    fn path(&self, id: u32) -> Result<&Path> {
+        self.paths
+            .get(id as usize)
+            .map(PathBuf::as_path)
+            .context("invalid path index")
+    }
+
+    fn check(&self) -> Result<()> {
+        ensure!(self.version == 1, "unsupported dependency bundle version");
+        ensure!(
+            self.paths.len() <= MAX_PATHS && self.records.len() <= MAX_RECORDS,
+            "bundle exceeds index budget"
+        );
+        ensure!(
+            self.resolutions.len() <= MAX_OBSERVATIONS && self.files.len() <= MAX_OBSERVATIONS,
+            "bundle exceeds observation budget"
+        );
+        for (path, target) in &self.resolutions {
+            ensure!(
+                self.path(*path)?.is_absolute(),
+                "resolution path must be absolute"
+            );
+            if let Some(target) = target {
+                ensure!(
+                    self.path(*target)?.is_absolute(),
+                    "resolution target must be absolute"
+                );
+            }
+        }
+        for (path, hash) in &self.files {
+            ensure!(
+                self.path(*path)?.is_absolute() && digest(hash),
+                "invalid file observation"
+            );
+        }
+        for (key, record) in &self.records {
+            ensure!(digest(key) && key == &record.key, "record key mismatch");
+            for id in &record.dependencies {
+                self.path(*id)?;
+            }
+            for id in &record.resolutions {
+                ensure!(
+                    (*id as usize) < self.resolutions.len(),
+                    "invalid resolution index"
+                );
+            }
+            for id in &record.files {
+                ensure!((*id as usize) < self.files.len(), "invalid file index");
+            }
+        }
+        Ok(())
+    }
+
+    pub fn lookup(&self, key: &str, view: &ReadView) -> Result<Option<Vec<PathBuf>>> {
+        let Some(record) = self.records.get(key) else {
+            return Ok(None);
+        };
+        for id in &record.resolutions {
+            let (path, target) = self.resolutions[*id as usize];
+            let target = target.map(|id| self.path(id)).transpose()?;
+            if view.resolve(self.path(path)?)?.as_deref() != target {
+                return Ok(None);
+            }
+        }
+        for id in &record.files {
+            let (path, hash) = &self.files[*id as usize];
+            if &view.fingerprint(self.path(*path)?)? != hash {
+                return Ok(None);
+            }
+        }
+        Ok(Some(
+            record
+                .dependencies
+                .iter()
+                .map(|id| self.path(*id).map(Path::to_owned))
+                .collect::<Result<_>>()?,
+        ))
+    }
+
+    pub fn updated(
+        &self,
+        updates: &BTreeMap<String, Recorded>,
+        used: &BTreeSet<String>,
+    ) -> Result<Self> {
+        ensure!(used.len() <= MAX_RECORDS, "too many dependency records");
+        let mut packed = Packer::new();
+        for key in used {
+            let record = if let Some(record) = updates.get(key) {
+                let dependencies = record
+                    .dependencies
+                    .iter()
+                    .map(|path| packed.path(path))
+                    .collect::<Result<_>>()?;
+                let resolutions = record
+                    .trace
+                    .resolutions
+                    .iter()
+                    .map(|(path, target)| packed.resolution(path, target.as_deref()))
+                    .collect::<Result<_>>()?;
+                let files = record
+                    .trace
+                    .files
+                    .iter()
+                    .map(|(path, hash)| packed.file(path, hash))
+                    .collect::<Result<_>>()?;
+                Entry {
+                    key: key.clone(),
+                    dependencies,
+                    resolutions,
+                    files,
+                }
+            } else {
+                let record = self
+                    .records
+                    .get(key)
+                    .context("used key has no saved or fresh record")?;
+                let dependencies = record
+                    .dependencies
+                    .iter()
+                    .map(|id| packed.path(self.path(*id)?))
+                    .collect::<Result<_>>()?;
+                let resolutions = record
+                    .resolutions
+                    .iter()
+                    .map(|id| {
+                        let (path, target) = self.resolutions[*id as usize];
+                        packed.resolution(
+                            self.path(path)?,
+                            target.map(|id| self.path(id)).transpose()?,
+                        )
+                    })
+                    .collect::<Result<_>>()?;
+                let files = record
+                    .files
+                    .iter()
+                    .map(|id| {
+                        let (path, hash) = &self.files[*id as usize];
+                        packed.file(self.path(*path)?, hash)
+                    })
+                    .collect::<Result<_>>()?;
+                Entry {
+                    key: key.clone(),
+                    dependencies,
+                    resolutions,
+                    files,
+                }
+            };
+            packed.bundle.records.insert(key.clone(), record);
+        }
+        packed.bundle.check()?;
+        Ok(packed.bundle)
+    }
+
+    pub fn counts(&self) -> Counts {
+        Counts {
+            paths: self.paths.len(),
+            resolutions: self.resolutions.len(),
+            files: self.files.len(),
+            records: self.records.len(),
+        }
+    }
+}
+
+struct Packer {
+    bundle: Bundle,
+    paths: HashMap<PathBuf, u32>,
+    resolutions: HashMap<PathBuf, u32>,
+    files: HashMap<PathBuf, u32>,
+}
+
+impl Packer {
+    fn new() -> Self {
+        Self {
+            bundle: Bundle::empty(),
+            paths: HashMap::new(),
+            resolutions: HashMap::new(),
+            files: HashMap::new(),
+        }
+    }
+
+    fn path(&mut self, path: &Path) -> Result<u32> {
+        if let Some(id) = self.paths.get(path) {
+            return Ok(*id);
+        }
+        ensure!(
+            self.bundle.paths.len() < MAX_PATHS,
+            "too many dependency paths"
+        );
+        let id = u32::try_from(self.bundle.paths.len())?;
+        self.bundle.paths.push(path.to_owned());
+        self.paths.insert(path.to_owned(), id);
+        Ok(id)
+    }
+
+    fn resolution(&mut self, path: &Path, target: Option<&Path>) -> Result<u32> {
+        let value = (
+            self.path(path)?,
+            target.map(|path| self.path(path)).transpose()?,
+        );
+        if let Some(id) = self.resolutions.get(path) {
+            ensure!(
+                self.bundle.resolutions[*id as usize] == value,
+                "conflicting resolution observations"
+            );
+            return Ok(*id);
+        }
+        ensure!(
+            self.bundle.resolutions.len() < MAX_OBSERVATIONS,
+            "too many resolution observations"
+        );
+        let id = u32::try_from(self.bundle.resolutions.len())?;
+        self.bundle.resolutions.push(value);
+        self.resolutions.insert(path.to_owned(), id);
+        Ok(id)
+    }
+
+    fn file(&mut self, path: &Path, hash: &str) -> Result<u32> {
+        let path_id = self.path(path)?;
+        if let Some(id) = self.files.get(path) {
+            ensure!(
+                self.bundle.files[*id as usize] == (path_id, hash.to_owned()),
+                "conflicting file observations"
+            );
+            return Ok(*id);
+        }
+        ensure!(
+            self.bundle.files.len() < MAX_OBSERVATIONS,
+            "too many file observations"
+        );
+        let id = u32::try_from(self.bundle.files.len())?;
+        self.bundle.files.push((path_id, hash.to_owned()));
+        self.files.insert(path.to_owned(), id);
+        Ok(id)
+    }
+}
