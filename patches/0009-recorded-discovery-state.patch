new file mode 100644
index 0000000..4161c4d
--- /dev/null
+++ b/crates/nix-ninja/src/discovery.rs
@@ -0,0 +1,612 @@
+use crate::discovery_bundle::{Bundle, Recorded, MAX_RECORDS};
+use crate::discovery_identity::{Identity, Namespace};
+use crate::discovery_policy::{self, CommandInputs, FilePolicy};
+use crate::discovery_state::{Directory, Loaded};
+use crate::input_view::InputViewLease;
+use anyhow::Result;
+use clap::ValueEnum;
+use deps_infer::c_include_parser::{
+    retrieve_c_dependency_paths, retrieve_c_dependency_paths_observed,
+};
+use deps_infer::observations::ReadView;
+use serde::Serialize;
+use std::collections::{BTreeMap, BTreeSet};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::Instant;
+
+const MAX_CAPTURE_BYTES: usize = 384 * 1024 * 1024;
+
+#[derive(Clone, Copy, Default, PartialEq, ValueEnum)]
+pub enum Mode {
+    #[default]
+    Off,
+    Record,
+}
+
+pub struct Options {
+    pub lease: Arc<InputViewLease>,
+    pub mode: Mode,
+    pub cache_dir: Option<PathBuf>,
+    pub code_sha256: String,
+    pub ambient_search: bool,
+    pub setup_ns: u64,
+}
+
+struct State {
+    directory: Option<Directory>,
+    updates: BTreeMap<String, Recorded>,
+    used: BTreeSet<String>,
+    bypasses: BTreeMap<&'static str, u64>,
+    load: String,
+    publication: &'static str,
+    finished: bool,
+    captured_bytes: usize,
+}
+
+#[derive(Serialize)]
+pub struct Report {
+    schema_version: u32,
+    mode: &'static str,
+    namespace: Option<String>,
+    calls: u64,
+    hits: u64,
+    validated_candidates: u64,
+    candidate_mismatches: u64,
+    validation_errors: u64,
+    scans: u64,
+    bypasses: BTreeMap<&'static str, u64>,
+    loaded_records: usize,
+    recorded_actions: usize,
+    estimated_record_bytes: usize,
+    load: String,
+    publication: &'static str,
+    setup_ns: u64,
+    planning_complete: bool,
+    cumulative_discovery_ns: u64,
+    cumulative_validation_ns: u64,
+    publication_ns: u64,
+    observations: Option<deps_infer::observations::ReadStats>,
+}
+
+pub struct Discovery {
+    options: Arc<Options>,
+    identity: Option<Identity>,
+    view: Option<Arc<ReadView>>,
+    previous: Bundle,
+    wrappers: BTreeMap<String, String>,
+    tool_roots: Vec<PathBuf>,
+    policy: Mutex<FilePolicy>,
+    state: Mutex<State>,
+    calls: AtomicU64,
+    scans: AtomicU64,
+    discovery_ns: AtomicU64,
+    validation_ns: AtomicU64,
+    validated: AtomicU64,
+    mismatches: AtomicU64,
+    validation_errors: AtomicU64,
+    publication_ns: AtomicU64,
+    setup_ns: u64,
+}
+
+impl Discovery {
+    pub fn new(options: Arc<Options>, namespace: Namespace) -> Self {
+        let start = Instant::now();
+        let mut state = State {
+            directory: None,
+            updates: BTreeMap::new(),
+            used: BTreeSet::new(),
+            bypasses: BTreeMap::new(),
+            load: "disabled".into(),
+            publication: "not-finished",
+            finished: false,
+            captured_bytes: 0,
+        };
+        let mut identity = None;
+        let mut view = None;
+        let mut previous = Bundle::empty();
+        if options.mode == Mode::Record {
+            let prepared = (|| -> Result<_> {
+                let identity = Identity::new(&namespace)?;
+                let view = options.lease.read_view()?;
+                let directory = Directory::open(
+                    options
+                        .cache_dir
+                        .as_deref()
+                        .ok_or_else(|| anyhow::anyhow!("record mode requires a cache directory"))?,
+                    &options.lease.root,
+                )?;
+                Ok((identity, view, directory))
+            })();
+            match prepared {
+                Ok((key, reads, directory)) => {
+                    match directory.load(&key.namespace) {
+                        Ok(Loaded::Hit(payload)) => match Bundle::decode(&payload) {
+                            Ok(bundle) => {
+                                previous = bundle;
+                                state.load = "loaded".into();
+                            }
+                            Err(_) => {
+                                state.load = "invalid-bundle".into();
+                            }
+                        },
+                        Ok(Loaded::Miss(reason)) => state.load = reason.into(),
+                        Err(_) => state.load = "read-error".into(),
+                    }
+                    state.directory = Some(directory);
+                    identity = Some(key);
+                    view = Some(reads);
+                }
+                Err(_) => state.load = "setup-error".into(),
+            }
+        }
+        let setup_ns = options
+            .setup_ns
+            .saturating_add(start.elapsed().as_nanos() as u64);
+        Self {
+            options,
+            identity,
+            view,
+            previous,
+            wrappers: namespace.wrapper_vars,
+            tool_roots: namespace.tools.into_values().map(PathBuf::from).collect(),
+            policy: Mutex::default(),
+            state: Mutex::new(state),
+            calls: AtomicU64::new(0),
+            scans: AtomicU64::new(0),
+            discovery_ns: AtomicU64::new(0),
+            validation_ns: AtomicU64::new(0),
+            validated: AtomicU64::new(0),
+            mismatches: AtomicU64::new(0),
+            validation_errors: AtomicU64::new(0),
+            publication_ns: AtomicU64::new(0),
+            setup_ns,
+        }
+    }
+
+    fn bypass(&self, reason: &'static str) {
+        *self
+            .state
+            .lock()
+            .unwrap()
+            .bypasses
+            .entry(reason)
+            .or_default() += 1;
+    }
+
+    fn fresh(&self, command: &str, seeds: Vec<PathBuf>) -> Result<Vec<PathBuf>> {
+        self.scans.fetch_add(1, Ordering::Relaxed);
+        retrieve_c_dependency_paths(command, seeds, None)
+    }
+
+    pub fn discover(
+        &self,
+        command: &str,
+        seeds: Vec<PathBuf>,
+        store_inputs: &[PathBuf],
+        generated: bool,
+    ) -> Result<Vec<PathBuf>> {
+        if generated {
+            let start = Instant::now();
+            self.calls.fetch_add(1, Ordering::Relaxed);
+            self.bypass("generated-input");
+            let result = self.fresh(command, seeds);
+            self.discovery_ns
+                .fetch_add(start.elapsed().as_nanos() as u64, Ordering::Relaxed);
+            return result;
+        }
+        if self.options.mode == Mode::Off || self.identity.is_none() {
+            return self.discover_resolved(command, seeds, store_inputs, None);
+        }
+        let compiler = shell_words::split(command)
+            .ok()
+            .and_then(|args| args.first().and_then(|name| which::which(name).ok()))
+            .and_then(|path| path.canonicalize().ok());
+        self.discover_resolved(command, seeds, store_inputs, compiler.as_deref())
+    }
+
+    fn discover_resolved(
+        &self,
+        command: &str,
+        seeds: Vec<PathBuf>,
+        store_inputs: &[PathBuf],
+        compiler: Option<&Path>,
+    ) -> Result<Vec<PathBuf>> {
+        let start = Instant::now();
+        self.calls.fetch_add(1, Ordering::Relaxed);
+        let result = (|| {
+            if self.options.mode == Mode::Off {
+                return self.fresh(command, seeds);
+            }
+            let (Some(identity), Some(view), Some(compiler)) =
+                (&self.identity, &self.view, compiler)
+            else {
+                self.bypass("unavailable-cache-or-compiler");
+                return self.fresh(command, seeds);
+            };
+            let mut roots = self.tool_roots.clone();
+            roots.extend_from_slice(store_inputs);
+            let action = CommandInputs {
+                command,
+                seeds: &seeds,
+                cwd: &self.options.lease.cwd,
+                compiler,
+                store_inputs: &roots,
+                wrapper_vars: &self.wrappers,
+                ambient_search: self.options.ambient_search,
+            };
+            let policy = match discovery_policy::command(&action, view) {
+                Ok(value) => value,
+                Err(reason) => {
+                    self.bypass(reason);
+                    return self.fresh(command, seeds);
+                }
+            };
+            let key = identity.action(command, &seeds, compiler)?;
+            let validation_start = Instant::now();
+            let candidate = match self.previous.lookup(&key, view) {
+                Ok(value) => value,
+                Err(_) => {
+                    self.validation_errors.fetch_add(1, Ordering::Relaxed);
+                    None
+                }
+            };
+            self.validation_ns.fetch_add(
+                validation_start.elapsed().as_nanos() as u64,
+                Ordering::Relaxed,
+            );
+            self.scans.fetch_add(1, Ordering::Relaxed);
+            let (dependencies, mut trace) =
+                match retrieve_c_dependency_paths_observed(command, seeds.clone(), view.clone()) {
+                    Ok(value) => value,
+                    Err(_) => {
+                        self.bypass("observation-error");
+                        return self.fresh(command, seeds);
+                    }
+                };
+            trace.resolutions.extend(policy.trace.resolutions);
+            if let Err(reason) = self.policy.lock().unwrap().trace(view, &trace) {
+                self.bypass(reason);
+                return Ok(dependencies);
+            }
+            if let Some(candidate) = candidate {
+                self.validated.fetch_add(1, Ordering::Relaxed);
+                if BTreeSet::from_iter(candidate)
+                    != BTreeSet::from_iter(dependencies.iter().cloned())
+                {
+                    self.mismatches.fetch_add(1, Ordering::Relaxed);
+                }
+            }
+            let mut state = self.state.lock().unwrap();
+            if state.finished {
+                state.publication = "late-discovery";
+                return Ok(dependencies);
+            }
+            let record = Recorded {
+                dependencies: dependencies.clone(),
+                trace,
+            };
+            let previous_bytes = state
+                .updates
+                .get(&key)
+                .map(Recorded::estimated_bytes)
+                .unwrap_or(0);
+            let captured_bytes = state
+                .captured_bytes
+                .saturating_sub(previous_bytes)
+                .saturating_add(record.estimated_bytes());
+            if captured_bytes > MAX_CAPTURE_BYTES
+                || (!state.used.contains(&key) && state.used.len() >= MAX_RECORDS)
+            {
+                *state.bypasses.entry("record-budget").or_default() += 1;
+                return Ok(dependencies);
+            }
+            state.captured_bytes = captured_bytes;
+            state.used.insert(key.clone());
+            state.updates.insert(key, record);
+            Ok(dependencies)
+        })();
+        self.discovery_ns
+            .fetch_add(start.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        result
+    }
+
+    pub fn finish(&self) {
+        let start = Instant::now();
+        let mut state = self.state.lock().unwrap();
+        if state.finished {
+            return;
+        }
+        state.finished = true;
+        if self.options.mode == Mode::Off {
+            state.publication = "disabled";
+            return;
+        }
+        let Some(identity) = &self.identity else {
+            state.publication = "disabled";
+            return;
+        };
+        let payload = self
+            .previous
+            .updated(&state.updates, &state.used)
+            .and_then(|bundle| bundle.encode());
+        state.publication = match payload {
+            Ok(payload) => match state.directory.as_mut() {
+                Some(directory) => match directory.publish(&identity.namespace, &payload) {
+                    Ok(()) => "published",
+                    Err(_) => "write-error",
+                },
+                None => "disabled",
+            },
+            Err(_) => "bundle-error",
+        };
+        self.publication_ns
+            .store(start.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    }
+
+    pub fn report(&self) -> Report {
+        let state = self.state.lock().unwrap();
+        Report {
+            schema_version: 1,
+            mode: if self.options.mode == Mode::Off {
+                "off"
+            } else {
+                "record"
+            },
+            namespace: self
+                .identity
+                .as_ref()
+                .map(|identity| identity.namespace.clone()),
+            calls: self.calls.load(Ordering::Relaxed),
+            hits: 0,
+            validated_candidates: self.validated.load(Ordering::Relaxed),
+            candidate_mismatches: self.mismatches.load(Ordering::Relaxed),
+            validation_errors: self.validation_errors.load(Ordering::Relaxed),
+            scans: self.scans.load(Ordering::Relaxed),
+            bypasses: state.bypasses.clone(),
+            loaded_records: self.previous.counts().records,
+            recorded_actions: state.used.len(),
+            estimated_record_bytes: state.captured_bytes,
+            load: state.load.clone(),
+            publication: state.publication,
+            setup_ns: self.setup_ns,
+            planning_complete: state.finished,
+            cumulative_discovery_ns: self.discovery_ns.load(Ordering::Relaxed),
+            cumulative_validation_ns: self.validation_ns.load(Ordering::Relaxed),
+            publication_ns: self.publication_ns.load(Ordering::Relaxed),
+            observations: self.view.as_ref().map(|view| view.stats()),
+        }
+    }
+}
+
