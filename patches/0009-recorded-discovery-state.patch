+        assert_eq!(lease.cwd, fixture.cwd());
+        assert_eq!(python_lock(&fixture.0.join("view.lock")), 23);
+        assert!(fixture.acquire().is_err());
+        let worker = Arc::clone(&lease);
+        drop(lease);
+        assert_eq!(python_lock(&fixture.0.join("view.lock")), 23);
+        drop(worker);
+        eventually(|| python_lock(&fixture.0.join("view.lock")) == 0);
+        eventually(|| fixture.acquire().is_ok());
+    }
