+        }
+        fn check(&self, text: &str, seeds: &[PathBuf]) -> Check<Policy> {
+            let roots = vec![PathBuf::from(
+                "/nix/store/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-cc",
+            )];
+            command(
+                &CommandInputs {
+                    command: text,
+                    seeds,
+                    cwd: &self.0,
+                    compiler: &roots[0].join("bin/cc"),
+                    store_inputs: &roots,
+                    wrapper_vars: &BTreeMap::new(),
+                    ambient_search: false,
+                },
+                &ReadView::new(&self.0, &self.0).unwrap(),
+            )
+        }
+    }
+    impl Drop for Fixture {
