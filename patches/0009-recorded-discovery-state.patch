+    #[test]
+    fn aliased_control_files_and_nonprivate_controllers_are_rejected() {
+        let fixture = Fixture::new();
+        let lock = fixture.0.join("view.lock");
+        let target = fixture.0.join("other.lock");
+        fs::rename(&lock, &target).unwrap();
+        std::os::unix::fs::symlink(&target, &lock).unwrap();
+        assert!(fixture.acquire().is_err());
+        fs::remove_file(&lock).unwrap();
+        fs::rename(&target, &lock).unwrap();
+        let marker = fixture.marker();
+        let target = fixture.0.join("other.json");
+        fs::rename(&marker, &target).unwrap();
+        std::os::unix::fs::symlink(&target, &marker).unwrap();
+        assert!(fixture.acquire().is_err());
+        fs::remove_file(&marker).unwrap();
+        fs::rename(&target, &marker).unwrap();
+        fs::set_permissions(&fixture.0, fs::Permissions::from_mode(0o755)).unwrap();
+        assert!(fixture.acquire().is_err());
+    }
