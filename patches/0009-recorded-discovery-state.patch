+        let saved = Bundle::decode(&saved.encode().unwrap()).unwrap();
+        assert!(saved
+            .lookup(&key('a'), &fixture.view())
+            .unwrap()
+            .unwrap()
+            .contains(&alias));
+        fs::remove_file(&alias).unwrap();
+        std::os::unix::fs::symlink("second.h", &alias).unwrap();
+        assert!(saved.lookup(&key('a'), &fixture.view()).unwrap().is_none());
+    }
+
+    #[test]
+    fn malformed_indices_keys_and_versions_are_rejected() {
+        let fixture = Fixture::new();
+        let source = fixture.write("main.c", "int value;\n");
+        let records = BTreeMap::from([(key('a'), fixture.record(&source))]);
+        let saved = Bundle::empty()
+            .updated(&records, &BTreeSet::from([key('a')]))
+            .unwrap();
+        let original: serde_json::Value = serde_json::from_str(&saved.encode().unwrap()).unwrap();
+        let mut bad = original.clone();
+        bad["version"] = serde_json::json!(99);
+        assert!(Bundle::decode(&bad.to_string()).is_err());
+        let mut bad = original.clone();
+        bad["records"][key('a')]["dependencies"][0] = serde_json::json!(u32::MAX);
+        assert!(Bundle::decode(&bad.to_string()).is_err());
+        let mut bad = original.clone();
+        bad["records"][key('a')]["key"] = serde_json::json!(key('b'));
+        assert!(Bundle::decode(&bad.to_string()).is_err());
+        let mut bad = original;
+        bad["files"][0][0] = serde_json::json!(u32::MAX);
+        assert!(Bundle::decode(&bad.to_string()).is_err());
+    }
+
+    #[test]
+    fn inconsistent_snapshots_cannot_be_published_together() {
+        let fixture = Fixture::new();
+        let first = fixture.write("first.c", "#include \"shared.h\"\n");
+        let second = fixture.write("second.c", "#include \"shared.h\"\n");
+        fixture.write("shared.h", "#define VALUE 1\n");
+        let old = fixture.record(&first);
+        fixture.write("shared.h", "#define VALUE 2\n");
+        let mixed = BTreeMap::from([(key('a'), old), (key('b'), fixture.record(&second))]);
+        assert!(Bundle::empty()
+            .updated(&mixed, &BTreeSet::from([key('a'), key('b')]))
+            .is_err());
+    }
+}
diff --git a/crates/nix-ninja/src/discovery_identity.rs b/crates/nix-ninja/src/discovery_identity.rs
