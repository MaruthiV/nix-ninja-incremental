+    #[test]
+    fn link_validation_rejects_uncontrolled_paths_before_scanning() {
+        let fixture = Fixture::new();
+        let source = fixture.0.join("inputs/value.h");
+        fs::write(&source, b"int value;\n").unwrap();
+        let alias = fixture.0.join("inputs/alias.h");
+        std::os::unix::fs::symlink("value.h", &alias).unwrap();
+        let lease = fixture.acquire().unwrap();
+        assert_eq!(
+            lease.read_view().unwrap().resolve(&alias).unwrap(),
+            Some(source)
+        );
+        drop(lease);
+        fs::remove_file(&alias).unwrap();
+        std::os::unix::fs::symlink(fixture.0.join("missing-external"), &alias).unwrap();
+        assert!(fixture.acquire().is_err());
+        fs::remove_file(&alias).unwrap();
+        eventually(|| fixture.acquire().is_ok());
+    }
