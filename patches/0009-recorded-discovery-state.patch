+            assert!(fixture.check(text, &seeds).is_err(), "{text}");
+        }
+        assert!(fixture.check("cc -I. -std=c23 -c main.c", &seeds).is_ok());
+    }
+
+    #[test]
+    fn forced_headers_require_the_seeded_build_path_and_negative_searches() {
+        let fixture = Fixture::new();
+        let main = fixture.write("main.c", "int value;\n");
+        fs::create_dir(fixture.0.join("early")).unwrap();
+        let header = fixture.write("late/config.h", "#define VALUE 1\n");
+        let seeds = vec![main, header];
+        let saved = fixture
+            .check("cc -Iearly -Ilate -include config.h", &seeds)
+            .unwrap();
+        assert_eq!(
+            saved.trace.resolutions[&fixture.0.join("early/config.h")],
+            None
+        );
+        fixture.write("early/config.h", "#define VALUE 2\n");
+        assert!(!ReadView::new(&fixture.0, &fixture.0)
+            .unwrap()
+            .validate(&saved.trace)
+            .unwrap());
+        assert_eq!(
+            fixture
+                .check("cc -Iearly -Ilate -include config.h", &seeds)
+                .err(),
+            Some("forced-header-not-seeded")
+        );
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn equal_physical_forced_header_is_insufficient_with_another_logical_parent() {
+        let fixture = Fixture::new();
+        let header = fixture.write("real/config.h", "#include \"near.h\"\n");
+        fs::create_dir(fixture.0.join("alias")).unwrap();
+        std::os::unix::fs::symlink("../real/config.h", fixture.0.join("alias/config.h")).unwrap();
+        assert_eq!(
+            fixture
+                .check("cc -Ialias -include config.h", &[header])
+                .err(),
+            Some("forced-header-not-seeded")
+        );
+    }
+
+    #[test]
+    fn file_checks_cover_queries_computed_forms_and_raw_data_boundaries() {
+        for text in [
+            "#include PICK_HEADER\n",
+            "#include_next <value.h>\n",
+            "#import \"value.h\"\n",
+            "#embed RESOURCE\n",
+            "#include /* comment */ \"value.h\"\n",
+            "/* comment */ #include \"value.h\"\n",
+            "#if __has_include(\"probe.h\")\n#define VALUE 1\n#endif\n",
+            "#if __has_include(PICK_HEADER)\n#endif\n",
+            "#inc\\\nlude \"value.h\"\n",
+        ] {
+            assert!(source(text.as_bytes()).is_err(), "{text}");
+        }
+        assert!(source(b"#if __has_include(\"value.h\")\n#include \"value.h\"\n#endif\n").is_ok());
+        assert!(source(b"#if __has_embed(\"data.bin\")\n#embed \"data.bin\"\n#endif\n").is_ok());
+        assert!(source(&[0xff, b'\n']).is_err());
+        let fixture = Fixture::new();
+        let main = fixture.write(
+            "main.c",
+            "unsigned char data[] = {\n#embed \"data.bin\"\n};\n",
+        );
+        fixture.write("data.bin", "#include COMPUTED\n");
+        let view = Arc::new(ReadView::new(&fixture.0, &fixture.0).unwrap());
+        let (_, trace) =
+            retrieve_c_dependency_paths_observed("cc", vec![main], view.clone()).unwrap();
+        assert!(FilePolicy::default().trace(&view, &trace).is_ok());
+    }
+
+    #[test]
+    fn mutable_system_paths_and_ambient_search_are_rejected() {
+        let fixture = Fixture::new();
+        fixture.write("include/value.h", "int value;\n");
+        assert_eq!(
+            fixture.check("cc -isystem include", &[]).err(),
+            Some("unguarded-system-root")
+        );
+        let action = CommandInputs {
+            command: "cc",
+            seeds: &[],
+            cwd: &fixture.0,
+            compiler: Path::new("/nix/store/cc/bin/cc"),
+            store_inputs: &[],
+            wrapper_vars: &BTreeMap::new(),
+            ambient_search: true,
+        };
+        assert_eq!(
+            command(&action, &ReadView::new(&fixture.0, &fixture.0).unwrap()).err(),
+            Some("ambient-compiler-search")
+        );
+    }
+}
diff --git a/crates/nix-ninja/src/discovery_state.rs b/crates/nix-ninja/src/discovery_state.rs
new file mode 100644
index 0000000..c3af7c3
--- /dev/null
+++ b/crates/nix-ninja/src/discovery_state.rs
@@ -0,0 +1,431 @@
+use anyhow::{ensure, Result};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::fs::{self, File, OpenOptions};
+use std::io::{Read, Seek, SeekFrom, Write};
+use std::os::unix::fs::{DirBuilderExt, MetadataExt, OpenOptionsExt};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+
+const MAX_BYTES: u64 = 64 * 1024 * 1024;
+const OWNER: &str = ".nix-ninja-discovery-owner";
+const MAGIC: &[u8] = b"nix-ninja local dependency state\n";
+const TEMP_PREFIX: &str = ".nni-discovery.tmp-";
+static NEXT_TEMP: AtomicU64 = AtomicU64::new(0);
+
+#[derive(Serialize, Deserialize)]
+struct Envelope {
+    version: u32,
+    namespace: String,
+    payload: String,
+    checksum: String,
+}
+
+#[derive(Debug, PartialEq)]
+pub enum Loaded {
+    Hit(String),
+    Miss(&'static str),
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum Publication {
+    Written,
+    Renamed,
+}
+
+pub struct Directory {
+    root: PathBuf,
+    _owner: File,
+}
+
+impl Directory {
+    pub fn open(requested: &Path, protected: &Path) -> Result<Self> {
+        let protected = protected.canonicalize()?;
+        let uid = fs::metadata(&protected)?.uid();
+        let root = if requested.exists() {
+            ensure!(
+                !fs::symlink_metadata(requested)?.is_symlink(),
+                "cache root must not be a symlink"
+            );
+            requested.canonicalize()?
+        } else {
+            let parent = requested
+                .parent()
+                .ok_or_else(|| anyhow::anyhow!("cache root needs a parent"))?
+                .canonicalize()?;
+            parent.join(
+                requested
+                    .file_name()
+                    .ok_or_else(|| anyhow::anyhow!("cache root needs a name"))?,
+            )
+        };
+        ensure!(
+            !root.starts_with(&protected),
+            "cache must be outside build inputs"
+        );
+        match fs::DirBuilder::new().mode(0o700).create(&root) {
+            Ok(()) => {}
+            Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {}
+            Err(error) => return Err(error.into()),
+        }
+        let metadata = fs::symlink_metadata(&root)?;
+        ensure!(
+            metadata.is_dir() && metadata.uid() == uid && metadata.mode() & 0o777 == 0o700,
+            "cache root must be private and have the input-view owner"
+        );
+        let marker = root.join(OWNER);
+        let mut owner = match fs::symlink_metadata(&marker) {
+            Ok(metadata) => {
+                ensure!(
+                    metadata.is_file() && metadata.uid() == uid && metadata.mode() & 0o777 == 0o600,
+                    "invalid cache owner file"
+                );
+                OpenOptions::new().read(true).write(true).open(&marker)?
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                ensure!(
+                    root.read_dir()?.next().is_none(),
+                    "unowned cache directory is not empty"
+                );
+                OpenOptions::new()
+                    .read(true)
+                    .write(true)
+                    .create_new(true)
+                    .mode(0o600)
+                    .open(&marker)?
+            }
+            Err(error) => return Err(error.into()),
+        };
+        owner.try_lock()?;
+        ensure!(
+            owner.metadata()?.len() <= MAGIC.len() as u64,
+            "invalid cache owner marker"
+        );
+        let mut found = Vec::new();
+        owner.read_to_end(&mut found)?;
+        if found != MAGIC {
+            let only_marker = root
+                .read_dir()?
+                .all(|entry| entry.is_ok_and(|entry| entry.file_name() == OWNER));
+            ensure!(
+                only_marker && MAGIC.starts_with(&found),
+                "cache owner marker mismatch"
+            );
+            owner.seek(SeekFrom::Start(0))?;
+            owner.set_len(0)?;
+            owner.write_all(MAGIC)?;
+        }
+        let directory = Self {
+            root,
+            _owner: owner,
+        };
+        directory.cleanup_temps()?;
+        Ok(directory)
+    }
+
+    fn cleanup_temps(&self) -> Result<()> {
+        for entry in self.root.read_dir()? {
+            let entry = entry?;
+            let name = entry.file_name();
+            let Some(suffix) = name
+                .to_str()
+                .and_then(|name| name.strip_prefix(TEMP_PREFIX))
+            else {
+                continue;
+            };
+            let parts: Vec<_> = suffix.split('-').collect();
+            let owned = parts.len() == 2
+                && parts
+                    .iter()
+                    .all(|part| !part.is_empty() && part.bytes().all(|byte| byte.is_ascii_digit()));
+            if owned && entry.file_type()?.is_file() {
+                fs::remove_file(entry.path())?;
+            }
+        }
+        Ok(())
+    }
+
+    pub fn load(&self, namespace: &str) -> Result<Loaded> {
+        let path = self.root.join("state.json");
+        let metadata = match fs::symlink_metadata(&path) {
+            Ok(metadata) => metadata,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                return Ok(Loaded::Miss("absent"))
+            }
+            Err(error) => return Err(error.into()),
+        };
+        if !metadata.is_file() {
+            return Ok(Loaded::Miss("non-regular"));
+        }
+        if metadata.len() > MAX_BYTES {
+            return Ok(Loaded::Miss("oversized"));
+        }
+        let bytes = fs::read(path)?;
+        let envelope: Envelope = match serde_json::from_slice(&bytes) {
+            Ok(envelope) => envelope,
+            Err(_) => return Ok(Loaded::Miss("malformed")),
+        };
+        if envelope.version != 1 {
+            return Ok(Loaded::Miss("version"));
+        }
+        if envelope.namespace != namespace {
+            return Ok(Loaded::Miss("namespace"));
+        }
+        if envelope.checksum != format!("{:x}", Sha256::digest(envelope.payload.as_bytes())) {
+            return Ok(Loaded::Miss("checksum"));
+        }
+        Ok(Loaded::Hit(envelope.payload))
+    }
+
+    pub fn publish(&mut self, namespace: &str, payload: &str) -> Result<()> {
+        self.publish_with(namespace, payload, |_| {})
+    }
+
+    fn publish_with(
+        &mut self,
+        namespace: &str,
+        payload: &str,
+        mut hook: impl FnMut(Publication),
+    ) -> Result<()> {
+        ensure!(
+            payload.len() as u64 <= MAX_BYTES,
+            "cache payload exceeds its budget"
+        );
+        let envelope = Envelope {
+            version: 1,
+            namespace: namespace.to_owned(),
+            payload: payload.to_owned(),
+            checksum: format!("{:x}", Sha256::digest(payload.as_bytes())),
+        };
+        let bytes = serde_json::to_vec(&envelope)?;
+        ensure!(
+            bytes.len() as u64 <= MAX_BYTES,
+            "cache envelope exceeds its budget"
+        );
+        self.cleanup_temps()?;
+        let id = NEXT_TEMP.fetch_add(1, Ordering::Relaxed);
+        let temporary = self
+            .root
+            .join(format!("{TEMP_PREFIX}{}-{id}", std::process::id()));
+        let mut file = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(&temporary)?;
+        file.write_all(&bytes)?;
+        drop(file);
+        hook(Publication::Written);
+        fs::rename(temporary, self.root.join("state.json"))?;
+        hook(Publication::Renamed);
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::{symlink, PermissionsExt};
+    use std::process::Command;
+
+    struct Fixture {
+        root: PathBuf,
+        protected: PathBuf,
+        cache: PathBuf,
+    }
+
+    impl Fixture {
+        fn new() -> Self {
+            let id = NEXT_TEMP.fetch_add(1, Ordering::Relaxed);
+            let root =
+                std::env::temp_dir().join(format!("nni-state-test-{}-{id}", std::process::id()));
+            fs::create_dir(&root).unwrap();
+            let protected = root.join("inputs");
+            fs::create_dir(&protected).unwrap();
+            let cache = root.join("cache");
+            Self {
+                root,
+                protected,
+                cache,
+            }
+        }
+
+        fn open(&self) -> Directory {
+            Directory::open(&self.cache, &self.protected).unwrap()
+        }
+
+        fn child(&self, mode: &str) -> std::process::ExitStatus {
+            Command::new(std::env::current_exe().unwrap())
+                .args([
+                    "--exact",
+                    "discovery_state::tests::child_process",
+                    "--ignored",
+                ])
+                .env("NNI_STATE_CHILD_MODE", mode)
+                .env("NNI_STATE_CHILD_ROOT", &self.root)
+                .output()
+                .unwrap()
+                .status
+        }
+    }
+
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.root);
+        }
+    }
+
+    #[test]
+    fn roundtrip_and_namespace_miss() {
+        let fixture = Fixture::new();
+        let mut directory = fixture.open();
+        assert_eq!(directory.load("a").unwrap(), Loaded::Miss("absent"));
+        directory.publish("a", r#"{"answer":42}"#).unwrap();
+        assert_eq!(
+            directory.load("a").unwrap(),
+            Loaded::Hit(r#"{"answer":42}"#.to_owned())
+        );
+        assert_eq!(directory.load("b").unwrap(), Loaded::Miss("namespace"));
+    }
+
+    #[test]
+    fn malformed_old_and_corrupt_records_are_disposable() {
+        let fixture = Fixture::new();
+        let mut directory = fixture.open();
+        let state = fixture.cache.join("state.json");
+        fs::write(&state, b"{\"version\":").unwrap();
+        assert_eq!(directory.load("a").unwrap(), Loaded::Miss("malformed"));
+        directory.publish("a", "payload").unwrap();
+        let mut envelope: Envelope = serde_json::from_slice(&fs::read(&state).unwrap()).unwrap();
+        envelope.version = 0;
+        fs::write(&state, serde_json::to_vec(&envelope).unwrap()).unwrap();
+        assert_eq!(directory.load("a").unwrap(), Loaded::Miss("version"));
+        envelope.version = 1;
+        envelope.payload.push('x');
+        fs::write(&state, serde_json::to_vec(&envelope).unwrap()).unwrap();
+        assert_eq!(directory.load("a").unwrap(), Loaded::Miss("checksum"));
+        directory.publish("a", "recovered").unwrap();
+        assert_eq!(
+            directory.load("a").unwrap(),
+            Loaded::Hit("recovered".to_owned())
+        );
+    }
+
+    #[test]
+    fn unowned_or_input_directories_are_not_modified() {
+        let fixture = Fixture::new();
+        fs::create_dir(&fixture.cache).unwrap();
+        fs::set_permissions(&fixture.cache, fs::Permissions::from_mode(0o700)).unwrap();
+        fs::write(fixture.cache.join("notes.txt"), "keep this").unwrap();
+        assert!(Directory::open(&fixture.cache, &fixture.protected).is_err());
+        assert!(!fixture.cache.join(OWNER).exists());
+        assert_eq!(
+            fs::read_to_string(fixture.cache.join("notes.txt")).unwrap(),
+            "keep this"
+        );
+        let inside = fixture.protected.join("cache");
+        assert!(Directory::open(&inside, &fixture.protected).is_err());
+        assert!(!inside.exists());
+    }
+
+    #[test]
+    fn cache_lock_excludes_another_process_until_release() {
+        let fixture = Fixture::new();
+        let directory = fixture.open();
+        assert_eq!(fixture.child("open").code(), Some(43));
+        drop(directory);
+        assert!(fixture.child("open").success());
+    }
+
+    #[test]
+    fn process_exit_at_publication_boundaries_recovers() {
+        for (mode, expected) in [("before", "old"), ("after", "new")] {
+            let fixture = Fixture::new();
+            {
+                let mut directory = fixture.open();
+                directory.publish("a", "old").unwrap();
+            }
+            assert_eq!(fixture.child(mode).code(), Some(86));
+            let directory = fixture.open();
+            assert_eq!(
+                directory.load("a").unwrap(),
+                Loaded::Hit(expected.to_owned())
+            );
+            assert!(!fixture.cache.read_dir().unwrap().any(|entry| entry
+                .unwrap()
+                .file_name()
+                .to_string_lossy()
+                .starts_with(TEMP_PREFIX)));
+        }
+    }
+
+    #[test]
+    fn oversized_and_symlinked_state_are_not_trusted() {
+        let fixture = Fixture::new();
+        let mut directory = fixture.open();
+        let state = fixture.cache.join("state.json");
+        File::create(&state)
+            .unwrap()
+            .set_len(MAX_BYTES + 1)
+            .unwrap();
+        assert_eq!(directory.load("a").unwrap(), Loaded::Miss("oversized"));
+        fs::remove_file(&state).unwrap();
+        let source = fixture.protected.join("source.txt");
+        fs::write(&source, "source").unwrap();
+        symlink(&source, &state).unwrap();
+        assert_eq!(directory.load("a").unwrap(), Loaded::Miss("non-regular"));
+        directory.publish("a", "new").unwrap();
+        assert_eq!(fs::read_to_string(source).unwrap(), "source");
+        assert_eq!(directory.load("a").unwrap(), Loaded::Hit("new".to_owned()));
+    }
+
+    #[test]
+    fn interrupted_marker_initialization_and_temps_recover() {
+        let fixture = Fixture::new();
+        fs::create_dir(&fixture.cache).unwrap();
+        fs::set_permissions(&fixture.cache, fs::Permissions::from_mode(0o700)).unwrap();
+        OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(fixture.cache.join(OWNER))
+            .unwrap();
+        {
+            let _directory = fixture.open();
+        }
+        fs::write(fixture.cache.join(format!("{TEMP_PREFIX}1-2")), "partial").unwrap();
+        fs::write(fixture.cache.join("notes.txt"), "keep").unwrap();
+        {
+            let _directory = fixture.open();
+        }
+        assert!(!fixture.cache.join(format!("{TEMP_PREFIX}1-2")).exists());
+        assert_eq!(
+            fs::read_to_string(fixture.cache.join("notes.txt")).unwrap(),
+            "keep"
+        );
+    }
+
+    #[test]
+    #[ignore]
+    fn child_process() {
+        let Ok(mode) = std::env::var("NNI_STATE_CHILD_MODE") else {
+            return;
+        };
+        let root = PathBuf::from(std::env::var_os("NNI_STATE_CHILD_ROOT").unwrap());
+        let result = Directory::open(&root.join("cache"), &root.join("inputs"));
+        let Ok(mut directory) = result else {
+            std::process::exit(43);
+        };
+        if mode == "open" {
+            return;
+        }
+        directory
+            .publish_with("a", "new", |point| {
+                if (mode == "before" && point == Publication::Written)
+                    || (mode == "after" && point == Publication::Renamed)
+                {
+                    std::process::exit(86);
+                }
+            })
+            .unwrap();
+    }
+}
diff --git a/crates/nix-ninja/src/input_view.rs b/crates/nix-ninja/src/input_view.rs
new file mode 100644
index 0000000..d83ec58
--- /dev/null
+++ b/crates/nix-ninja/src/input_view.rs
@@ -0,0 +1,265 @@
+use anyhow::{ensure, Context, Result};
+use deps_infer::observations::ReadView;
+use serde::Deserialize;
+use std::fs::{self, File, OpenOptions};
+use std::os::unix::fs::MetadataExt;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use walkdir::WalkDir;
+
+#[derive(Deserialize)]
+struct Descriptor {
+    schema_version: u32,
+    id: String,
+    root: PathBuf,
+}
+
+pub struct InputViewLease {
+    pub id: String,
+    pub root: PathBuf,
+    pub cwd: PathBuf,
+    _lock: File,
+}
+
+fn regular(path: &Path, uid: u32) -> Result<fs::Metadata> {
+    let metadata = fs::symlink_metadata(path)?;
+    ensure!(
+        metadata.is_file() && metadata.uid() == uid && metadata.mode() & 0o777 == 0o600,
+        "input-view control file must be private, regular and owned by the controller"
+    );
+    ensure!(metadata.nlink() == 1, "input-view control file has aliases");
+    Ok(metadata)
+}
+
+impl InputViewLease {
+    pub fn acquire(marker: &Path, cwd: &Path) -> Result<Arc<Self>> {
+        ensure!(
+            marker.file_name().is_some_and(|name| name == "view.json"),
+            "expected an input-view descriptor"
+        );
+        let control = marker
+            .parent()
+            .context("input-view descriptor has no controller")?
+            .canonicalize()?;
+        let metadata = fs::metadata(&control)?;
+        ensure!(
+            metadata.is_dir() && metadata.mode() & 0o777 == 0o700,
+            "input-view controller must be private"
+        );
+        let uid = metadata.uid();
+        let lock_path = control.join("view.lock");
+        let expected = regular(&lock_path, uid)?;
+        let lock = OpenOptions::new().read(true).write(true).open(&lock_path)?;
+        lock.try_lock().context("input view is busy")?;
+        let locked = lock.metadata()?;
+        let current = regular(&lock_path, uid)?;
+        ensure!(
+            expected.dev() == locked.dev()
+                && expected.ino() == locked.ino()
+                && current.dev() == locked.dev()
+                && current.ino() == locked.ino(),
+            "input-view lock changed during acquisition"
+        );
+        let marker = control.join("view.json");
+        let metadata = regular(&marker, uid)?;
+        ensure!(
+            metadata.len() <= 64 * 1024,
+            "input-view descriptor is oversized"
+        );
+        let descriptor: Descriptor = serde_json::from_slice(&fs::read(marker)?)?;
+        ensure!(
+            descriptor.schema_version == 1,
+            "unsupported input-view version"
+        );
+        ensure!(
+            descriptor.id.len() == 32
+                && descriptor
+                    .id
+                    .bytes()
+                    .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte)),
+            "invalid input-view identity"
+        );
+        let root = control.join("inputs");
+        ensure!(
+            descriptor.root == root && root.canonicalize()? == root,
+            "input-view root does not match its controller"
+        );
+        ensure!(
+            fs::metadata(&root)?.is_dir() && fs::metadata(&root)?.uid() == uid,
+            "input-view root has a different owner"
+        );
+        let cwd = cwd.canonicalize()?;
+        ensure!(
+            cwd.starts_with(&root)
+                && fs::metadata(&cwd)?.is_dir()
+                && fs::metadata(&cwd)?.uid() == uid,
+            "working directory is outside the owned input view"
+        );
+        let lease = Arc::new(Self {
+            id: descriptor.id,
+            root,
+            cwd,
+            _lock: lock,
+        });
+        let view = lease.read_view()?;
+        for entry in WalkDir::new(&lease.root).follow_links(false) {
+            let entry = entry?;
+            if entry.file_type().is_symlink() {
+                view.resolve(entry.path())?;
+            } else {
+                ensure!(
+                    entry.file_type().is_dir() || entry.file_type().is_file(),
+                    "input view contains an unsupported file type"
+                );
+            }
+        }
+        Ok(lease)
+    }
+
+    pub fn read_view(&self) -> Result<Arc<ReadView>> {
+        Ok(Arc::new(ReadView::new(&self.root, &self.cwd)?))
+    }
