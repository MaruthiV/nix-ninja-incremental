+        }
+    }
+
+    #[test]
+    fn known_unmodeled_commands_bypass_before_observation() {
+        let fixture = Fixture::new();
+        let seeds = vec![fixture.write("main.c", "int value;\n")];
+        for text in [
+            "cc @args",
+            "cc -I=include",
+            "cc -iquote include",
+            "cc -include-pch saved.pch",
+            "cc -Wp,-Iinclude",
+            "cc -Xpreprocessor -Iinclude",
+            "cc --sysroot=/sdk",
+            "cc -fmodules-ts",
+            "cc -x assembler",
